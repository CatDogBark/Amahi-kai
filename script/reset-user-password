#!/usr/bin/env ruby
# frozen_string_literal: true

# Reset a web UI password from the server itself.
#
#   script/reset-user-password            list the admin accounts
#   script/reset-user-password USERNAME   set a new password for USERNAME
#
# The password is never taken on the command line, where it would end up in shell
# history and the process list. On a terminal it asks twice at a hidden prompt.
# Otherwise it reads the password from standard input, which lets a Proxmox host
# reset it through the guest agent without logging in to the VM:
#
#   read -rs -p "New password: " PW; echo
#   printf '%s' "$PW" | qm guest exec 104 --timeout 180 --pass-stdin 1 -- /opt/amahi-kai/script/reset-user-password admin
#   unset PW
#
# Run it as root or as the app user. It loads the production settings from
# /etc/amahi-kai/amahi.env (as the service does) and drops to the app user before
# starting Rails, so nothing it writes ends up owned by root.
# Only the web UI password changes; Samba passwords are stored separately.

require "etc"
require "io/console"

APP_DIR = File.expand_path("..", __dir__)
ENV_FILE = ENV.fetch("ENV_FILE", "/etc/amahi-kai/amahi.env")
APP_USER = ENV.fetch("APP_USER", "amahi")
USAGE = <<~TEXT
  Usage: script/reset-user-password [USERNAME]

  With no USERNAME, lists the admin accounts.
  With a USERNAME, sets a new web UI password for it. The password is read at a
  hidden prompt, or from standard input when that isn't a terminal.
TEXT

def fail!(message)
  warn "reset-user-password: #{message}"
  exit 1
end

if ARGV.any? { |arg| %w[-h --help].include?(arg) }
  puts USAGE
  exit 0
end
fail!("expected at most one USERNAME\n\n#{USAGE}") if ARGV.size > 1
username = ARGV.first

# The service gets these from systemd's EnvironmentFile; load them the same way here.
if File.readable?(ENV_FILE)
  File.foreach(ENV_FILE) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.delete_prefix("export ").split("=", 2)
    next if value.nil?

    value = value.strip
    value = value[1..-2] if value.length >= 2 && value[0] == value[-1] && %w[" '].include?(value[0])
    ENV[key.strip] ||= value
  end
elsif ENV["SECRET_KEY_BASE"].to_s.empty?
  fail!("can't read #{ENV_FILE}; run this as root or as #{APP_USER}")
end
ENV["RAILS_ENV"] ||= "production"

# Start Rails as the app user so its logs and caches stay owned by that user.
if Process.uid.zero?
  begin
    account = Etc.getpwnam(APP_USER)
  rescue ArgumentError
    fail!("there is no user named #{APP_USER} (set APP_USER to the app's user)")
  end
  Process.initgroups(APP_USER, account.gid)
  Process::GID.change_privilege(account.gid)
  Process::UID.change_privilege(account.uid)
  ENV["HOME"] = account.dir
  ENV["USER"] = ENV["LOGNAME"] = APP_USER
end

Dir.chdir(APP_DIR)
require File.join(APP_DIR, "config", "environment")

if username.nil?
  admins = User.where(role: "admin").order(:login).pluck(:login)
  puts admins.empty? ? "No admin accounts found." : "Admin accounts: #{admins.join(', ')}"
  puts "To set a new password: script/reset-user-password USERNAME"
  exit 0
end

user = User.find_by(login: username)
fail!("there is no user named #{username.inspect}") if user.nil?

password =
  if $stdin.tty?
    first = $stdin.getpass("New password for #{user.login}: ")
    second = $stdin.getpass("Repeat it: ")
    fail!("the two passwords don't match; nothing changed") unless first == second
    first
  else
    $stdin.read.to_s.chomp
  end
fail!("the password is empty; nothing changed") if password.empty?

user.password = user.password_confirmation = password
fail!("#{user.errors.full_messages.to_sentence}; nothing changed") unless user.save
puts "Web UI password updated for #{user.login}."
