# Brings the file search index up to date with what changed in the shares (every 10 minutes,
# amahi-kai-indexer.timer).
[Unit]
Description=Amahi-kai Share File Indexer
After=amahi-kai.service mariadb.service

[Service]
Type=oneshot
User=amahi
Group=amahi
WorkingDirectory=/opt/amahi-kai
EnvironmentFile=/etc/amahi-kai/amahi.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/bundle exec rails shares:update_index
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amahi-kai-indexer
