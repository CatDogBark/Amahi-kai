<%# Reusable streaming install terminal modal
    Usage: render 'shared/install_terminal', id: 'greyhole', title: 'Installing Greyhole', stream_url: path
    Then a button with data-call="openInstallTerminal" data-args='["greyhole"]' (install_terminal.js)
%>
<% id ||= 'install' %>
<% title ||= 'Installing...' %>
<% stream_url ||= '' %>

<%# Each window carries its own stream address, for openInstallTerminal(id) without a url. %>
<div id="<%= id %>-install-modal" data-stream-url="<%= stream_url %>" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; z-index:9999; background:rgba(0,0,0,0.7); align-items:center; justify-content:center; padding:20px;">
  <%# A column whose bars never change height: the terminal takes what's left, so the window
      doesn't jump when the buttons appear and nothing is pushed off a short screen. %>
  <div style="width:700px; max-width:100%; max-height:100%; display:flex; flex-direction:column; background:#1a1a2e; border-radius:12px; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.5);">
    <div style="flex:none; padding:16px 20px; background:#16213e; display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; align-items:center; gap:8px;">
        <span style="width:12px; height:12px; border-radius:50%; background:#ff5f57;"></span>
        <span style="width:12px; height:12px; border-radius:50%; background:#febc2e;"></span>
        <span style="width:12px; height:12px; border-radius:50%; background:#28c840;"></span>
      </div>
      <span style="color:#7f8c9b; font-size:13px; font-family:monospace;"><%= title %></span>
      <div style="width:52px;"></div>
    </div>
    <div id="<%= id %>-terminal" style="flex:1 1 auto; min-height:0; height:400px; padding:20px; overflow-y:auto; font-family:'SF Mono',Consolas,'Liberation Mono',Menlo,monospace; font-size:13px; line-height:1.6; color:#a0e8af;">
      <div id="<%= id %>-output"></div>
      <span id="<%= id %>-cursor" style="animation:termBlink 1s step-end infinite;">▌</span>
    </div>
    <%# The status bar is always there; pages show, hide or rewrite only the button area
        (#<id>-install-footer) inside it. %>
    <div id="<%= id %>-install-bar" class="term-bar">
      <span id="<%= id %>-status" class="term-status"></span>
      <div id="<%= id %>-install-footer" style="display:none; text-align:right;">
        <button type="button" class="btn btn-sm btn-outline-light" data-call="closeInstallTerminal" data-args='["<%= id %>"]'>Close & Refresh</button>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes termBlink { 50% { opacity: 0; } }
  [id$="-terminal"] { scrollbar-width: thin; scrollbar-color: #333 transparent; }
  [id$="-terminal"]::-webkit-scrollbar { width: 6px; }
  [id$="-terminal"]::-webkit-scrollbar-track { background: transparent; }
  [id$="-terminal"]::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
  .term-line { margin: 0; white-space: pre-wrap; word-break: break-all; }
  .term-line.step { color: #64b5f6; font-weight: bold; margin-top: 4px; }
  .term-line.success { color: #a0e8af; font-weight: bold; }
  .term-line.error { color: #ff6b6b; font-weight: bold; }
  .term-line.warn { color: #febc2e; }
  .term-bar { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 12px;
              min-height: 56px; padding: 12px 20px; background: #16213e; }
  .term-status { color: #7f8c9b; font-size: 13px; font-family: 'SF Mono', Consolas, 'Liberation Mono', Menlo, monospace; }
  .term-status.success { color: #a0e8af; }
  .term-status.error { color: #ff6b6b; }
  .term-status.warn { color: #febc2e; }
</style>

