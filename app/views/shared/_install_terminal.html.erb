<%# Reusable streaming install window (its look: install_terminal.css)
    Usage: render 'shared/install_terminal', id: 'greyhole', title: 'Installing Greyhole', stream_url: path
    Then a button with data-call="openInstallTerminal" data-args='["greyhole"]' (install_terminal.js)
%>
<% id ||= 'install' %>
<% title ||= 'Installing...' %>
<% stream_url ||= '' %>

<%# Each window carries its own stream address, for openInstallTerminal(id) without a url, and
    its state (running, done, failed, waiting) for the pill in its title bar. %>
<div id="<%= id %>-install-modal" class="term-modal" data-stream-url="<%= stream_url %>" data-state="running" style="display:none;">
  <%# A column whose bars never change height: the output takes what's left, so the window
      doesn't jump when the buttons appear and nothing is pushed off a short screen. %>
  <div class="term-window" role="dialog" aria-modal="true" aria-labelledby="<%= id %>-title">
    <div class="term-head">
      <span class="term-title" id="<%= id %>-title"><%= title %></span>
      <span class="term-pill" id="<%= id %>-pill"><span class="term-dot" aria-hidden="true"></span><span class="term-pill-text">Running</span></span>
    </div>
    <div id="<%= id %>-terminal" class="term-body">
      <div id="<%= id %>-output"></div>
      <span id="<%= id %>-cursor" class="term-cursor" aria-hidden="true">▌</span>
    </div>
    <%# The status bar is always there; pages show, hide or rewrite only the button area
        (#<id>-install-footer) inside it. %>
    <div id="<%= id %>-install-bar" class="term-bar">
      <span id="<%= id %>-status" class="term-status"></span>
      <div id="<%= id %>-install-footer" class="term-actions" style="display:none;">
        <button type="button" class="btn btn-sm btn-primary" data-call="closeInstallTerminal" data-args='["<%= id %>"]'>Close & Refresh</button>
      </div>
    </div>
  </div>
</div>
