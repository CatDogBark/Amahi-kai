<%= render 'shared/storage_alerts', health: @health %>
<div class="settings-table" id="disks-table">
  <!-- Greyhole Status -->
  <div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="mb-0"><%= t('greyhole_status', default: 'Greyhole Status') %></h5>
      <% if @greyhole_status[:installed] %>
        <span class="badge <%= @greyhole_status[:running] ? 'bg-success' : 'bg-secondary' %>">
          <%= @greyhole_status[:running] ? t('running', default: 'Running') : t('stopped', default: 'Stopped') %>
        </span>
      <% else %>
        <span class="badge bg-warning text-dark"><%= t('not_installed', default: 'Not Installed') %></span>
      <% end %>
    </div>
    <div class="card-body">
      <% if @greyhole_status[:installed] %>
        <div class="d-flex flex-wrap align-items-center gap-2">
          <%= button_to(@greyhole_status[:running] ? t('stop', default: 'Stop') : t('start', default: 'Start'),
                disks_toggle_greyhole_path,
                method: :post,
                form: { class: 'd-inline-flex' },
                disabled: !@greyhole_status[:running] && @pool_drives.empty?,
                class: "btn btn-sm #{@greyhole_status[:running] ? 'btn-outline-danger' : 'btn-outline-success'}") %>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="uninstall-greyhole-btn" <%= 'disabled' if @greyhole_removal_blocker %>
                  onclick="if (confirm('Uninstall Greyhole? Shares stay as they are; installing it again later brings pooling back.')) openInstallTerminal('greyhole-uninstall')">Uninstall</button>
          <span class="text-muted small">
            <% if @greyhole_status[:running] %>
              <%= t('pending_operations', default: 'Pending operations') %>: <%= @greyhole_status.dig(:queue, :pending).to_i %>
            <% elsif @pool_drives.empty? %>
              Stopped: it has nothing to do until drives are in its pool (below), and starts when the first one goes in.
            <% else %>
              Stopped: Start sets it working on the pool again.
            <% end %>
          </span>
        </div>
        <% if @greyhole_removal_blocker %>
          <p class="small text-muted mb-0 mt-2" id="greyhole-removal-blocker">To uninstall Greyhole: <%= @greyhole_removal_blocker %></p>
        <% end %>
      <% else %>
        <p class="text-muted mb-2"><%= t('greyhole_not_installed_msg', default: 'Greyhole is not installed. Install it to enable storage pooling and drive replication.') %></p>
        <button type="button" class="btn btn-primary" onclick="openInstallTerminal('greyhole')">
          Install Greyhole
        </button>
      <% end %>
    </div>
  </div>

  <%# Pool Summary — only show when drives exist %>
  <% if @pool_drives.any? %>
    <%
      pool_total = @pool_drives.sum { |d| d[:total].to_i }
      pool_used = @pool_drives.sum { |d| d[:used].to_i }
      pool_free = @pool_drives.sum { |d| d[:free].to_i }
      pool_pct = pool_total > 0 ? (pool_used.to_f / pool_total * 100).round(1) : 0
      # Each share keeps its own number of copies (max: one on every drive), and a file
      # can't have more copies than there are drives.
      pooled = Share.where('disk_pool_copies > 0').order(:name).to_a
      copies_of = ->(share) { share.disk_pool_copies >= 99 ? @pool_drives.size : [share.disk_pool_copies, @pool_drives.size].min }
      bar_color = pool_pct > 90 ? '#dc3545' : pool_pct > 70 ? '#ffc107' : '#0d8aa8'
    %>
    <div class="card mb-3">
      <div class="card-header">
        <h5 class="mb-0">Pool Summary</h5>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span>
            <strong><%= number_to_human_size(pool_used) %></strong> used of
            <strong><%= number_to_human_size(pool_total) %></strong> raw
            <span class="text-muted ms-2">(<%= number_to_human_size(pool_free) %> free)</span>
          </span>
          <span style="font-size: 1.1em; font-weight: 600; color: <%= bar_color %>"><%= pool_pct %>%</span>
        </div>
        <div style="height: 12px; background: var(--kai-card-bg, #1a1a2e); border-radius: 6px; overflow: hidden;">
          <div style="height: 100%; width: <%= pool_pct %>%; background: <%= bar_color %>; border-radius: 6px; transition: width 0.3s;"></div>
        </div>
        <div class="d-flex flex-wrap justify-content-between gap-2 mt-2 text-muted" style="font-size: 0.85em;" id="pool-copies">
          <span>
            <%= pluralize(@pool_drives.size, 'drive') %> ·
            <% if pooled.any? %>
              <%= pooled.map { |share| "#{share.name}: #{pluralize(copies_of.call(share), 'copy')}" }.join(', ') %>
            <% else %>
              no share keeps copies here yet (set a share's Disk Pool copies on Shares)
            <% end %>
          </span>
          <% if pooled.any? %>
            <span>
              Room for about
              <%= pooled.map { |share| copies_of.call(share) }.uniq.sort.map { |n| "#{number_to_human_size(pool_total / n)} of files at #{pluralize(n, 'copy')}" }.join(', or ') %>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Pool Drives -->
  <div class="card mb-3">
    <div class="card-header">
      <h5 class="mb-0"><%= t('storage_pool_drives', default: 'Storage Pool Drives') %></h5>
    </div>
    <div class="card-body">
      <% if @pool_drives.any? %>
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th><%= t('path', default: 'Path') %></th>
              <th><%= t('total_space') %></th>
              <th><%= t('free_space') %></th>
              <th><%= t('used_space') %></th>
              <th><%= t('min_free', default: 'Min Free (GB)') %></th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @pool_drives.each do |drive| %>
              <tr class="<%= 'table-warning' if %i[changed not_mounted].include?(drive[:state]) %>" id="pool-drive-<%= drive[:path].parameterize %>">
                <td>
                  <%= drive[:path] %>
                  <% case drive[:state] %>
                  <% when :changed %>
                    <div class="small text-warning">Greyhole isn't using this drive: it isn't the one Greyhole had here (it was swapped or formatted). Use this drive tells Greyhole to take it.</div>
                  <% when :not_mounted %>
                    <div class="small text-warning">Nothing is mounted here, so Greyhole can't use it. Mount the drive on <%= link_to 'Devices', disks_devices_path %>, or remove it from the pool.</div>
                  <% end %>
                </td>
                <td><%= number_to_human_size(drive[:total]) %></td>
                <td><%= number_to_human_size(drive[:free]) %></td>
                <td><%= number_to_human_size(drive[:used]) %></td>
                <td><%= drive[:minimum_free] %> GB</td>
                <td class="text-nowrap">
                  <% if drive[:state] == :changed %>
                    <%= button_to 'Use this drive', disks_accept_pool_drive_path,
                          params: { path: drive[:path] }, method: :post, form: { class: 'd-inline-block' },
                          class: 'btn btn-sm btn-warning',
                          data: { confirm: "Use the drive now mounted at #{drive[:path]} in Greyhole's pool? Greyhole forgets the drive it had here; files that were only there come back from their other copies, if they have any.",
                                  disable_with: 'Working...' } %>
                  <% end %>
                  <%= button_to(t('remove', default: 'Remove'),
                        disks_toggle_disk_pool_partition_path(path: drive[:path]),
                        method: :put,
                        class: 'btn btn-sm btn-outline-danger',
                        data: { confirm: t('are_you_sure', default: 'Are you sure?') }) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted mb-0"><%= t('no_pool_drives', default: 'No drives in the storage pool yet. Add partitions below.') %></p>
      <% end %>
    </div>
  </div>

  <!-- Available Partitions -->
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0"><%= t('available_partitions', default: 'Available Partitions') %></h5>
    </div>
    <div class="card-body">
      <% pool_paths = @pool_partitions.pluck(:path) %>
      <% if @partitions.any? %>
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th><%= t('partition', default: 'Partition') %></th>
              <th><%= t('path', default: 'Path') %></th>
              <th><%= t('total_space') %></th>
              <th><%= t('free_space') %></th>
              <th><%= t('in_pool', default: 'In Pool') %></th>
            </tr>
          </thead>
          <tbody>
            <% @partitions.each do |part| %>
              <tr>
                <td><%= part[:device] %></td>
                <td><%= part[:path] %></td>
                <td><%= number_to_human_size(part[:bytes_total]) %></td>
                <td><%= number_to_human_size(part[:bytes_free]) %></td>
                <td>
                  <% checked = pool_paths.include?(part[:path]) %>
                  <%= render partial: 'shares/disk_pooling_partition_checkbox',
                             locals: { checked: checked, path: part[:path] } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted mb-0" id="no-share-drives">
          No share storage yet. Greyhole pools drives mounted as share storage: initialize and mount them on
          <%= link_to 'Disks → Devices', disks_devices_path %>, and they show up here to add.
        </p>
      <% end %>
    </div>
  </div>
</div>



<%= render 'shared/install_terminal', id: 'greyhole-uninstall', title: 'Uninstalling Greyhole', stream_url: disks_uninstall_greyhole_stream_path %>
<%= render 'shared/install_terminal',
     id: 'greyhole',
     title: 'Installing Greyhole',
     stream_url: disks_install_greyhole_stream_path %>
