<%# The ZFS Pools page's dialogs, opened by data-pool-dialog buttons (storage_pools.js fills
    in the pool and posts the change): replace a drive, add a group of drives, delete a pool.
    free: the drives a pool may take (StoragePools.drives). %>
<div class="modal fade" id="replace-dialog" tabindex="-1" aria-labelledby="replace-dialog-title" aria-hidden="true" data-url="<%= disks_replace_pool_drive_path %>">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="replace-dialog-title">Replace a drive in <span data-fill="name"></span></h5></div>
      <div class="modal-body">
        <p class="small">Replacing <strong data-fill="old-label"></strong>. Choose the new drive (at least as big):</p>
        <%= render 'disks/free_drive_choice', free: free, type: 'radio', name: 'new' %>
        <p class="small text-muted">ZFS copies the pool's data onto the new drive (a resilver), and keeps using the old drive, if it's still there, until it's done. The pool stays usable meanwhile.</p>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="replace-erase" data-confirm-erase="">
          <label class="form-check-label small" for="replace-erase">Erase everything on the new drive</label>
        </div>
      </div>
      <div class="modal-footer">
        <span class="text-danger small me-auto" data-dialog-error=""></span>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-warning" data-dialog-submit="" disabled>Replace</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="add-dialog" tabindex="-1" aria-labelledby="add-dialog-title" aria-hidden="true" data-url="<%= disks_add_pool_group_path %>">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="add-dialog-title">Add drives to <span data-fill="name"></span></h5></div>
      <div class="modal-body">
        <p class="small">A pool grows by one more group shaped like its others: choose <strong><span data-fill="width"></span> drives</strong> for a new <span data-fill="layout-name"></span> group.</p>
        <%= render 'disks/free_drive_choice', free: free, type: 'checkbox', name: 'devices[]' %>
        <p class="small mb-2" data-add-estimate=""></p>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="add-erase" data-confirm-erase="">
          <label class="form-check-label small" for="add-erase">Erase everything on the chosen drives</label>
        </div>
        <p class="small text-muted mt-2 mb-0">A group can't be taken out of a pool again.</p>
      </div>
      <div class="modal-footer">
        <span class="text-danger small me-auto" data-dialog-error=""></span>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" data-dialog-submit="" disabled>Add drives</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="destroy-dialog" tabindex="-1" aria-labelledby="destroy-dialog-title" aria-hidden="true" data-url="<%= disks_destroy_pool_path %>">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="destroy-dialog-title">Delete the pool <span data-fill="name"></span></h5></div>
      <div class="modal-body">
        <p class="small">Everything on the pool is destroyed, snapshots included. Its drives are wiped and become free for share storage or a new pool. This can't be undone.</p>
        <label class="form-label small" for="destroy-confirm">Type <strong data-fill="name"></strong> to confirm</label>
        <input type="text" class="form-control form-control-sm" id="destroy-confirm" autocomplete="off" data-confirm-name="">
      </div>
      <div class="modal-footer">
        <span class="text-danger small me-auto" data-dialog-error=""></span>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" data-dialog-submit="" disabled>Delete pool</button>
      </div>
    </div>
  </div>
</div>
