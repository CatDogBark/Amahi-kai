<%# Disks → Pool Trash (GreyholeTrash): what Greyhole keeps of files deleted from pooled shares %>
<%= render 'shared/storage_alerts', health: @health %>
<div class="settings-table" id="pool-trash">
  <div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
      <h5 class="mb-0"><%= t('pool_trash') %></h5>
      <% if @greyhole_installed && @trash[:count].positive? %>
        <%= button_to 'Empty trash', disks_trash_empty_path, method: :post, form: { class: 'd-inline-flex' },
              class: 'btn btn-sm btn-outline-danger', id: 'empty-trash',
              data: { confirm: "Delete all #{pluralize(@trash[:count], 'file')} in the trash for good? This frees #{number_to_human_size(@trash[:space])} on the pool drives.",
                      disable_with: 'Emptying…' } %>
      <% end %>
    </div>
    <div class="card-body">
      <p class="small text-muted" id="trash-about">
        When a file in a pooled share is deleted, or changed, Greyhole keeps the old copy here, on the drives that had it,
        until the trash is emptied. Restore puts a file back where it was, and Greyhole makes its copies again.
      </p>
      <% if !@greyhole_installed %>
        <p class="mb-0 text-muted">Greyhole isn't installed, so there's no pool trash.</p>
      <% elsif @trash[:count].zero? %>
        <p class="mb-0" id="trash-summary">The trash is empty.</p>
      <% else %>
        <p id="trash-summary">
          <strong><%= pluralize(@trash[:count], 'file') %></strong>, using <%= number_to_human_size(@trash[:space]) %> on the pool drives
          (every copy counted).
          <% if @trash[:count] > @trash[:items].size %>
            The newest <%= @trash[:items].size %> are listed.
          <% end %>
        </p>
        <div class="table-responsive">
          <table class="table table-sm align-middle mb-0">
            <thead>
              <tr>
                <th>File</th>
                <th>Size</th>
                <th>In the trash since</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @trash[:items].each do |item| %>
                <tr class="trash-item">
                  <td class="text-break">
                    <span class="text-muted"><%= item.share %>/</span><%= item.path %>
                    <% if item.copies > 1 %><span class="small text-muted ms-1">(<%= item.copies %> copies)</span><% end %>
                  </td>
                  <td class="text-nowrap"><%= number_to_human_size(item.bytes) %></td>
                  <td class="text-nowrap small"><%= relative_time_tag(item.trashed_at, capitalize: true) %></td>
                  <td class="text-end text-nowrap">
                    <% if @pooled_shares.include?(item.share) %>
                      <%= button_to 'Restore', disks_trash_restore_path, method: :post, params: { share: item.share, path: item.path },
                            form: { class: 'd-inline-flex' }, class: 'btn btn-sm btn-outline-primary me-1',
                            data: { disable_with: 'Restoring…' } %>
                    <% else %>
                      <span class="small text-muted me-2">Its share isn't pooled now</span>
                    <% end %>
                    <%= button_to 'Delete', disks_trash_delete_path, method: :post, params: { share: item.share, path: item.path },
                          form: { class: 'd-inline-flex' }, class: 'btn btn-sm btn-outline-secondary',
                          data: { confirm: "Delete #{item.share}/#{item.path} for good?", disable_with: 'Deleting…' } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
