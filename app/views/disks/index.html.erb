<%= render 'shared/storage_alerts', health: @health %>
<div class="settings-table" id="disks-table">
  <table class="table table-striped">
    <thead>
      <tr>
        <th><%= t('model') %></th>
        <th><%= t('device') %></th>
        <th><%= t('size', default: 'Size') %></th>
        <th><%= t('temperature') %></th>
      </tr>
    </thead>
    <tbody>
      <% @disks.each do |disk| %>
        <tr>
          <td><%= disk[:model] %></td>
          <td><%= disk[:device] %></td>
          <td><%= disk[:size] %></td>
          <td class="disk-temp <%= disk[:tempcolor] %>"><%= disk[:temp_f] ? "#{disk[:temp_f]} °F" : '–' %></td>
        </tr>
      <% end %>
      <% if @disks.empty? %>
        <tr>
          <td colspan="4"><strong><%= t('no_disks_found', default: 'No disks found') %></strong></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
