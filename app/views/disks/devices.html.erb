<%= render 'shared/storage_alerts', health: @health %>
<div class="settings-table" id="disks-table">
  <% if @devices.empty? %>
    <div class="alert alert-info">No block devices detected.</div>
  <% end %>

  <% @devices.each do |device| %>
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <strong><%= device[:path] %></strong>
          <span class="text-muted ms-2"><%= device[:model] %></span>
          <span class="text-muted ms-2"><%= device[:size] %></span>
          <%= drive_health_badge(@health, device[:path], model: device[:model]) %>
        </div>
        <% if device[:os_disk] %>
          <span class="badge bg-warning text-dark">
            <%= lucide_icon('shield', size: 14) %> OS Disk
          </span>
        <% elsif device[:zfs_pool] %>
          <a href="<%= disks_pools_path %>" class="badge bg-info text-dark text-decoration-none">
            <%= lucide_icon('database', size: 14) %> ZFS pool <%= device[:zfs_pool] %>
          </a>
        <% end %>
      </div>
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Partition</th>
              <th>Size</th>
              <th>Filesystem</th>
              <th>Status</th>
              <th>Mount Point</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% device[:partitions].each do |part| %>
              <tr>
                <td><code><%= part[:path] %></code></td>
                <td><%= part[:size] %></td>
                <td><%= part[:fstype] || '—' %></td>
                <td>
                  <% case part[:status] %>
                  <% when :mounted %>
                    <span class="badge bg-success">Mounted</span>
                  <% when :unmounted %>
                    <span class="badge bg-info text-dark">Formatted</span>
                  <% when :unformatted %>
                    <span class="badge bg-secondary">Unformatted</span>
                  <% end %>
                </td>
                <td><%= part[:mountpoint] || '—' %></td>
                <td class="text-end">
                  <% unless device[:os_disk] || device[:zfs_pool] %>
                    <% case part[:status] %>
                    <% when :unformatted %>
                      <%= button_to "Initialize",
                            disks_format_disk_path,
                            params: { device: part[:path] },
                            method: :post,
                            class: "btn btn-sm btn-outline-danger",
                            data: { confirm: "⚠️ This will ERASE ALL DATA on #{part[:path]}. Are you sure?", disable_with: "Formatting..." } %>
                    <% when :unmounted %>
                      <% supported_fs = %w[ext2 ext3 ext4 xfs btrfs] %>
                      <div class="d-flex gap-1 justify-content-end">
                        <%= button_to "Preview",
                              disks_preview_disk_path,
                              params: { device: part[:path] },
                              method: :post,
                              class: "btn btn-sm btn-outline-info",
                              data: { disable_with: "Loading..." } %>
                        <% if supported_fs.include?(part[:fstype].to_s.downcase) %>
                          <%= button_to "Mount",
                                disks_mount_disk_path,
                                params: { device: part[:path] },
                                method: :post,
                                class: "btn btn-sm btn-outline-primary",
                                data: { disable_with: "Mounting..." } %>
                        <% else %>
                          <%= button_to "Mount as Share",
                                disks_mount_as_share_path,
                                params: { device: part[:path] },
                                method: :post,
                                class: "btn btn-sm btn-outline-success",
                                data: { tip: "Mount and create a network share (#{part[:fstype]} — not pooled)", disable_with: "Mounting..." } %>
                        <% end %>
                        <%= button_to "Format",
                              disks_format_disk_path,
                              params: { device: part[:path] },
                              method: :post,
                              class: "btn btn-sm btn-outline-danger",
                              data: { confirm: "Format #{part[:path]}? This erases everything on it: its #{part[:fstype] || 'filesystem'} and every file on it, for good. It gets a new, empty ext4 filesystem across all #{part[:size]}.",
                                      disable_with: "Formatting..." } %>
                      </div>
                    <% when :mounted %>
                      <% unless ['/', '/boot', '/boot/efi'].include?(part[:mountpoint]) %>
                        <%= button_to "Unmount",
                              disks_unmount_disk_path,
                              params: { device: part[:path] },
                              method: :post,
                              class: "btn btn-sm btn-outline-warning",
                              data: { confirm: "Unmount #{part[:path]} from #{part[:mountpoint]}?", disable_with: "Unmounting..." } %>
                      <% end %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>

<script>
document.querySelectorAll('[data-disable-with]').forEach(function(btn) {
  btn.closest('form').addEventListener('submit', function() {
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>' + btn.getAttribute('data-disable-with');
  });
});
</script>
