/ A secret of a custom app's form: the setting it goes in, and what its page calls it.
.kai-custom-row.kai-custom-row-secret data-custom-row=""
  .kai-custom-field
    label.form-label for="custom-secret-name-#{key}" Secret setting
    input.form-control.kai-mono id="custom-secret-name-#{key}" type="text" name="app[secrets][#{key}][name]" value=secret['name'] placeholder="SECRET_KEY" spellcheck="false" autocapitalize="off"
  .kai-custom-field
    label.form-label for="custom-secret-label-#{key}" Its page calls it
    input.form-control id="custom-secret-label-#{key}" type="text" name="app[secrets][#{key}][label]" value=secret['label'] placeholder="Secret key"
  button.btn.btn-outline-secondary.btn-sm.kai-custom-remove type="button" data-custom-remove="" aria-label="Remove this secret"
    = lucide_icon('x', size: 16)
