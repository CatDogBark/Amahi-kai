div.share[id="whole_share_#{share.id}"]

  table.settings.stretchtoggle
    tr.hover-style
      td.settings-col1.shares-col1
        span.share-name style="cursor:pointer; color:var(--kai-link, #5bc0de);"
          = share.name
      td.settings-col2.shares-col2
        = link_to path2location(share.name), path2uri(share.name)

  .settings-stretcher[style="display:none;"]
    /! One share's settings, by what they decide, each with what it does underneath.
    .share-manage.collapsed-div-style.share-card
      .share-card-title
        span.fw-semibold= share.name
        span.small.text-muted.ms-2= "#{t('created')} #{formatted_date(share.created_at)}"

      section.share-section id="share-section-access-#{share.id}"
        h6.share-section-title Access
        .share-row
          .share-row-label Who can use it
          .share-row-body
            = render :partial => 'shares/access', :object => share
            .share-help
              | With All users on, everyone with an account can open the share, and Writeable lets them change its files.
              |  Turn All users off to choose people one by one, and whether guests (no account) get in.
        .share-row
          .share-row-label Visible
          .share-row-body
            span data-controller="toggle" data-toggle-url-value=toggle_visible_share_path(id: share.id)
              input.share_visible_checkbox.form-check-input type="checkbox" id="share_visible_#{share.id}" autocomplete="off" checked=share.visible data-toggle-target="checkbox" data-action="click->toggle#toggle"
              |  Shown on the network
            .share-help
              | Computers browsing the network see it. Turned off, it's hidden from the list but still opens at #{path2location(share.name)}.
        .share-row
          .share-row-label People
          .share-row-body
            = render :partial => 'shares/permissions', :object => share
            .share-help Takes everyone off the share's list of people (used when All users is off), so only the people you tick again can open it.

      section.share-section id="share-section-storage-#{share.id}"
        h6.share-section-title Storage
        .share-row
          .share-row-label Folder
          .share-row-body data-controller="inline-edit" data-inline-edit-url-value=update_path_share_path(id: share.id) data-inline-edit-method-value="PUT"
            a.open-update-path-area.focus href="#" data-inline-edit-target="display" data-action="click->inline-edit#edit"
              = share.path
            form.update-path-form style="display:none" action=update_path_share_path(id: share.id) method="post" data-inline-edit-target="form" data-action="submit->inline-edit#submit"
              input type="hidden" name="_method" value="put"
              input type="hidden" name="authenticity_token" value=form_authenticity_token
              input.form-control.input-sm type="text" name="share[path]" value=share.path data-inline-edit-target="input"
              |  
              button.btnn.btn.btn-info.btn-sm type="submit"
                = t('change')
              a.cancel-btn-style.left-margin-10 href="#" data-action="click->inline-edit#cancel"
                | Cancel
            span.messages data-inline-edit-target="message"
            .share-help Where the share's files are kept on the NAS. Click it to change it.
        .share-row
          .share-row-label Size
          .share-row-body
            span.update-size-area id="size-area-#{share.id}"
              a.focus.remote-bt href="#" data-call="getShareSize" data-args='[#{share.id}]'
                span= t('get_the_size')
              span.spinner-border.spinner-border-sm.ms-1 id="size-spinner-#{share.id}" style="display:none"
            .share-help How much its files take up. Counting a big share takes a moment.
        .share-row
          .share-row-label Pool copies
          .share-row-body
            - copies = share.disk_pool_copies
            - if share.pool_removing?
              .small.text-info id="pool-removing-#{share.id}" data-reload-after="10"
                | Turning off: Greyhole is moving the share's files from the pool drives back into its folder. This page updates by itself when it's done.
            - else
              .d-flex.align-items-center.gap-2 id="pool-controls-#{share.id}" data-copies=copies
                button.btn.btn-sm.btn-outline-secondary data-pool-action="minus" data-call="updatePoolCopies" data-args='[#{share.id}, #{[copies - 1, 0].max}]' disabled=(copies <= 0) aria-label="Fewer copies"
                  | −
                span.fw-bold.mx-1 id="pool-copies-#{share.id}"
                  = copies == 0 ? 'Off' : "#{copies} #{copies == 1 ? 'copy' : 'copies'}"
                button.btn.btn-sm.btn-outline-secondary data-pool-action="plus" data-call="updatePoolCopies" data-args='[#{share.id}, #{[copies + 1, 2].min}]' disabled=(copies >= 2) aria-label="More copies"
                  | +
                span.spinner-border.spinner-border-sm.ms-1 id="pool-spinner-#{share.id}" style="display:none"
              .share-help id="pool-help-#{share.id}"
                | Over the network the share looks the same either way: this sets where its files are kept.
                |  Off: in the share's folder, on the system disk.
                |  1 copy: Greyhole moves them onto the Greyhole pool's drives and leaves links to them in the folder, which adds up the drives' space, but a drive that fails loses its files.
                |  2 copies: each file is kept on two drives, so one can fail and nothing is lost.
                - unless Greyhole.installed?
                  |  Install Greyhole on
                  =< link_to 'Disks → Greyhole Pool', disks_storage_pool_path
                  |  to use the pool.

      section.share-section id="share-section-trash-#{share.id}"
        h6.share-section-title= t('trash')
        .share-row
          .share-row-label Deleted files
          .share-row-body
            div
              - days = Trash.days
              | Kept in the
              =< link_to t('trash'), trash_path, id: "share-trash-#{share.id}"
              = days.zero? ? ' until it is emptied.' : " for #{pluralize(days, 'day')}, then deleted for good."
            .share-help
              - if copies.positive?
                | Greyhole keeps them on the pool drives. Restore them from the Trash, below the shares in the file browser; how long they're kept is set there.
              - else
                | They're kept in a hidden .recycle folder in the share. Restore them from the Trash, below the shares in the file browser; how long they're kept is set there.

      - if advanced?
        section.share-section id="share-section-advanced-#{share.id}"
          h6.share-section-title Advanced
          .share-row
            .share-row-label Samba settings
            .share-row-body
              .extras-editor id="extras-editor-#{share.id}"
                form action=update_extras_share_path(id: share.id) method="post" data-call="submitExtras" data-args='[#{share.id}, "@el"]'
                  input type="hidden" name="_method" value="put"
                  input type="hidden" name="authenticity_token" value=form_authenticity_token
                  textarea.form-control.form-control-sm.font-monospace name="share[extras]" rows="3" placeholder="key = value (one per line)" id="extras-textarea-#{share.id}" style="font-size: 0.8rem;"
                    = share.extras
                  .mt-1
                    button.btn.btn-info.btn-sm type="submit" style="font-size: 0.8rem;" Save
                    span.ms-2.text-success.small id="extras-msg-#{share.id}" style="display:none" Saved!
              .share-help
                | Extra settings for Samba, one per line, as smb.conf writes them. Amahi-kai checks them before Samba uses them, and refuses ones that could run programs.

      .share-card-footer
        span.delete data-controller="delete" data-delete-url-value=share_path(share) data-delete-confirm-value=confirm_share_destroy_message(share.name) data-delete-remove-selector-value="#whole_share_#{share.id}"
          a.btn-delete.remote-btn.btn.btn-sm href="#" data-action="click->delete#destroy"
            = t('delete') + ' ' + share.name
        span.share-help.ms-2 Deletes the share. Its files stay in its folder, and a new share with the same name opens them again. Turn a pooled share's copies Off first, so Greyhole moves its files back into the folder.
