- @share = @share || Share.new

form.share.create-form.form-horizontal.p-1.mt-2.bg-white[
  action=shares_path
  method="post"
  id="new-share-form"
  data-controller="create-form"
  data-create-form-target-value="#shares-table"
  data-action="submit->create-form#submit"]
  input type="hidden" name="authenticity_token" value=form_authenticity_token
  fieldset
    legend &nbsp; #{t('create_a_new_share')} &nbsp;
    - if @share&.errors&.any?
      .alert.alert-danger.m-2
        ul.mb-0
          - @share.errors.full_messages.each do |msg|
            li = msg
    .create-inside
      .control-group.form-group
        .controls
          input.form-control type="text" name="share[name]" size="16" maxlength="20" placeholder="Name" value=@share.name required=true

      / Where its files are kept, set now for good (SharesController#params_create_share)
      - choices = share_where_choices
      - if choices.size > 1
        .control-group.form-group
          .controls
            label.small.mb-1 for="share_where" Where its files are kept
            select.form-select.form-select-sm#share_where name="share[where]"
              - choices.each do |label, value|
                option value=value selected=(value == share_where_value(@share)) = label
            .messages
              | System disk: in the share's own folder on the NAS's disk. Greyhole pool: on the share drives, with copies on two of them.
              |  ZFS pool: on the pool, which keeps it safe across its drives, with its snapshots. It's set now and can't be changed later.
      - else
        input type="hidden" name="share[where]" value="disk"

      .control-group.form-group
        .controls
          input.right-margin-10 type="checkbox" name="share[visible]" value="1" checked="checked" id="share_visible"
          label for="share_visible"
            = t('visible')

      .control-group.form-group
        .controls
          input.right-margin-10 type="checkbox" name="share[rdonly]" value="1" id="share_rdonly"
          label for="share_rdonly"
            = t('read_only')

      .control-group.create-btn.form-group
        .controls
          = spinner
          button.btnn.btn-create.btn-info.btn.btn-sm type="submit" id="share_create_button"
            = t('create')
          a.close-area.cancel-link.cancel-btn-style.btn-sm.left-margin-10 href="#" data-related="#new-share-to-step1"
            = t('cancel')
