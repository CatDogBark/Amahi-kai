<div class="setup-center">
  <div class="setup-mark"><%= lucide_icon('waves', size: 34) %></div>
  <h2>You're all set</h2>
  <p>Here's what was set up.</p>
</div>

<div class="summary-list">
  <div class="summary-item">
    <% if @admin_password_changed %>
      <span class="check">✓</span>
      <span>Admin password changed</span>
    <% else %>
      <span class="missing">✗</span>
      <span>The admin password is still the default. <%= link_to "Change it", setup_admin_path %> to finish setup.</span>
    <% end %>
  </div>

  <div class="summary-item">
    <% if @server_name.present? %>
      <span class="check">✓</span>
      <span>Server name: <strong><%= @server_name %></strong></span>
    <% else %>
      <span class="skip">–</span>
      <span class="setup-muted">Server name (left as it was)</span>
    <% end %>
  </div>

  <div class="summary-item">
    <% if @pool_partitions.any? %>
      <span class="check">✓</span>
      <span>Greyhole pool: <strong><%= @pool_partitions.count %></strong> drive<%= @pool_partitions.count == 1 ? '' : 's' %></span>
    <% else %>
      <span class="skip">–</span>
      <span class="setup-muted">Storage pool (no drives added)</span>
    <% end %>
  </div>

  <% @standalone_shares.each do |share| %>
    <div class="summary-item">
      <span class="check">✓</span>
      <span>Drive shared as it is: <strong><%= share.name %></strong> (<%= share.path %>)</span>
    </div>
  <% end %>

  <div class="summary-item">
    <% if @greyhole_installed %>
      <span class="check">✓</span>
      <span>Greyhole installed: <strong><%= @default_copies %></strong> copies of each file</span>
    <% else %>
      <span class="skip">–</span>
      <span class="setup-muted">Greyhole (not installed)</span>
    <% end %>
  </div>

  <div class="summary-item">
    <% if @first_share.present? %>
      <span class="check">✓</span>
      <span>First share: <strong><%= @first_share %></strong></span>
    <% else %>
      <span class="skip">–</span>
      <span class="setup-muted">No shares yet</span>
    <% end %>
  </div>
</div>

<p class="setup-note">
  Next, install apps from <strong>Apps</strong>. To reach your server from anywhere, set up
  Tailscale or a Cloudflare Tunnel under <strong>Setup → Network → Remote Access</strong> (the
  Network tab shows once Advanced is on: the wrench in the header).
</p>

<div class="setup-center">
  <% if @admin_password_changed %>
    <%= form_tag(setup_finish_path, method: :post) do %>
      <button type="submit" class="btn-kai btn-wide">Go to the dashboard →</button>
    <% end %>
  <% else %>
    <%= link_to "Change the admin password", setup_admin_path, class: "btn-kai btn-wide" %>
  <% end %>
</div>
