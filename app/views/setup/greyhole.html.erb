<h2>Pool your drives with Greyhole</h2>

<% if @pool_drives.zero? %>
  <p>
    Greyhole combines several drives into one storage pool, and keeps extra copies of your files
    on different drives. No drive was added to the pool, so there's nothing to set up now: you can
    install Greyhole later on Disks → Greyhole Pool.
  </p>
  <div class="setup-actions">
    <a href="<%= setup_share_path %>" class="btn-kai">Continue →</a>
  </div>

<% elsif @greyhole_installed %>
  <p>
    <span class="setup-success">✓ Greyhole is installed.</span>
    Your pool has <strong><%= @pool_drives %></strong> drive<%= @pool_drives == 1 ? '' : 's' %>, and files are
    copied across them for safety.
  </p>

  <div class="setup-facts">
    <div class="setup-fact"><span>Copies of each file, for new shares</span><b class="setup-big-number"><%= @default_copies %></b></div>
    <span class="setup-hint">Each share's copies can be changed later on Shares.</span>
  </div>

  <div class="setup-actions">
    <a href="<%= setup_share_path %>" class="btn-kai">Continue →</a>
  </div>

<% else %>
  <p>
    <strong>Greyhole</strong> combines your <strong><%= @pool_drives %></strong> pool
    drive<%= @pool_drives == 1 ? '' : 's' %> into one storage pool. It spreads files across them and
    can keep extra copies, so if a drive fails your files are still on the other<%= @pool_drives == 1 ? '' : 's' %>.
  </p>

  <% if @pool_drives < 2 %>
    <div class="setup-warning-box">
      ⚠ With only one pool drive, Greyhole can manage it but can't keep a second copy of anything.
      Add another drive to protect your files.
    </div>
  <% end %>

  <label for="default_copies">Copies of each file</label>
  <select id="default_copies">
    <option value="1" <%= 'selected' if @pool_drives < 2 %>>1 copy (no extra copies)</option>
    <option value="2" <%= 'selected' if @pool_drives >= 2 %>>2 copies (recommended)</option>
    <% if @pool_drives >= 3 %>
      <option value="3">3 copies (the safest)</option>
    <% end %>
  </select>
  <p class="setup-hint">
    Each copy is kept on a different drive, so 2 copies take twice the space. Each share's copies
    can be changed later on Shares.
  </p>

  <div class="setup-actions">
    <a href="<%= setup_share_path %>" class="btn-skip">Skip for now</a>
    <button type="button" class="btn-kai" data-call="installGreyhole" data-args='["<%= setup_install_greyhole_stream_path %>", "<%= setup_share_path %>"]'>
      Install Greyhole →
    </button>
  </div>

  <%= render 'shared/install_terminal', id: 'greyhole-install', title: 'Installing Greyhole', stream_url: '' %>
<% end %>
