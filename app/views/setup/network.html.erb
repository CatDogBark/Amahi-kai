<h2>Name your server</h2>
<p>Here's what Amahi-kai found about your server. Give it a name your computers will see on the network.</p>

<div class="setup-facts">
  <div class="setup-fact"><span>Hostname</span><b><%= @hostname %></b></div>
  <div class="setup-fact"><span>IP address</span><b><%= @ip %></b></div>
</div>
<p class="setup-muted">
  To keep that address, give the server a fixed one on Network → Devices (This NAS) once setup is
  done, or reserve it in your router's DHCP settings.
</p>

<%= form_tag(setup_update_network_path, method: :post) do %>
  <label for="server_name">Server name</label>
  <input type="text" name="server_name" id="server_name" value="<%= @server_name %>" placeholder="e.g. home-server">

  <div class="setup-actions">
    <a href="<%= setup_storage_path %>" class="btn-skip">Skip</a>
    <button type="submit" class="btn-kai">Save &amp; continue →</button>
  </div>
<% end %>
