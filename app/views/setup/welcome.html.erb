<div class="setup-center">
  <div class="setup-mark"><%= lucide_icon('waves', size: 34) %></div>
  <h2>Welcome to Amahi-kai</h2>
  <p>
    Your home server is almost ready. A few quick steps set up your password, the server's name,
    your drives and a first share. It only takes a couple of minutes.
  </p>

  <div class="setup-facts" style="max-width: 420px; margin-left: auto; margin-right: auto;">
    <div class="setup-facts-title"><%= lucide_icon('monitor', size: 15) %> System memory</div>
    <div class="setup-fact">
      <span>RAM</span>
      <b><%= number_to_human_size(@memory[:total_mb] * 1024 * 1024, precision: 1) %></b>
    </div>
    <div class="setup-fact">
      <span>Swap</span>
      <% if @memory[:has_swap] %>
        <b class="setup-success"><%= number_to_human_size(@memory[:swap_mb] * 1024 * 1024, precision: 1) %> ✓</b>
      <% else %>
        <b class="setup-danger">None</b>
      <% end %>
    </div>
    <% if @memory[:needs_swap] %>
      <div class="setup-danger-box" style="margin-top: 8px;">
        <strong>Recommended:</strong> create a <%= @memory[:recommended_swap] %> swap file.
        A server with less than 8 GB of RAM can run out of memory during heavy work.
      </div>
      <button type="button" class="btn-kai" style="width: 100%;"
              data-call="openInstallTerminal" data-args='["swap-setup", "<%= setup_create_swap_path %>?size=<%= @memory[:recommended_swap] %>"]'>
        Create a <%= @memory[:recommended_swap] %> swap file
      </button>
    <% elsif @memory[:has_swap] %>
      <div class="setup-success setup-note" style="margin-top: 4px;">✓ Memory looks good</div>
    <% end %>
  </div>

  <a href="<%= setup_admin_path %>" class="btn-kai btn-wide">Let's get started →</a>
</div>

<%= render 'shared/install_terminal', id: 'swap-setup', title: 'Creating Swap File' %>
