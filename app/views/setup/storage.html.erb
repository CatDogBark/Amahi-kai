<h2>Choose your storage drives</h2>
<p>
  Tick the drives to use for your files: Amahi-kai prepares them and adds them to the Greyhole
  pool. The drive the system runs from is never offered. Leave unticked any drive you want for a
  ZFS pool later (Disks → ZFS Pools): a pool takes whole drives with nothing on them.
</p>

<%# A ZFS pool's drives are never offered (the helper won't format or mount them either): the pool is imported on Disks → ZFS Pools %>
<% pools = @devices.reject { |d| d[:os_disk] }.filter_map { |d| d[:zfs_pool] }.uniq %>
<% pools_named = "the ZFS #{'pool'.pluralize(pools.size)} #{pools.to_sentence}" %>
<% import_hint = "Import #{pools.one? ? 'it' : 'them'} on Disks → ZFS Pools once setup is done." %>

<% if @devices.any? { |d| !d[:os_disk] && !d[:zfs_pool] } %>
  <form id="storage-form" data-call="prepareDrives" data-args='["@event", "<%= setup_greyhole_path %>", "<%= setup_prepare_drives_stream_path %>"]'>
    <div class="drive-list">
      <% @devices.each do |device| %>
        <% next if device[:os_disk] || device[:zfs_pool] %>
        <% device[:partitions].each do |part| %>
          <% box_id = "drive_#{part[:path].gsub('/', '_')}" %>
          <div class="drive-item">
            <%# Each drive goes by its ref (DiskManager.resolve): a page left open acts on that drive or on none %>
            <input type="checkbox" name="drives[]" value="<%= part[:ref] %>" id="<%= box_id %>"
                   data-status="<%= part[:status] %>"
                   <%= 'checked' if @pool_paths.include?(part[:path]) || @pool_paths.include?(part[:mountpoint]) %>>
            <label for="<%= box_id %>">
              <span class="drive-path"><%= device[:model] %></span>
              <span class="setup-muted setup-note">(<%= part[:path] %>)</span>
            </label>
            <span class="drive-size"><%= part[:size] %></span>
            <div class="drive-detail">
              <% case part[:status] %>
              <% when :mounted %>
                <span class="setup-success">✓ Mounted at <%= part[:mountpoint] %></span>
                <span class="setup-muted" style="margin-left: 8px;"><%= part[:fstype] %></span>
              <% when :unmounted %>
                <% fs_supported = %w[ext2 ext3 ext4 xfs btrfs].include?(part[:fstype].to_s.downcase) %>
                <span class="setup-warning">⚠ Has a <%= part[:fstype] %> filesystem (it may hold files)</span>
                <a href="#" class="setup-link" style="margin-left: 8px;"
                   data-call="previewDrive" data-args='["<%= part[:ref] %>", "<%= setup_preview_drive_path %>", "<%= part[:path] %>"]'>Preview its files</a>
                <div style="margin-top: 4px;">
                  <% unless fs_supported %>
                    <div class="setup-muted">Mounted as a share of its own, outside the pool (Greyhole can't use <%= part[:fstype] %>).</div>
                    <label class="setup-danger">
                      <input type="checkbox" name="format_drives[]" value="<%= part[:ref] %>" disabled data-requires="<%= box_id %>">
                      Format it as ext4 instead (erases everything on it) to pool it
                    </label>
                  <% else %>
                    <label class="setup-muted">
                      <input type="checkbox" name="format_drives[]" value="<%= part[:ref] %>" disabled data-requires="<%= box_id %>">
                      Format it as ext4 (erases everything on it)
                    </label>
                    <span class="setup-hint">or leave it unticked to use it as it is</span>
                  <% end %>
                </div>
              <% when :unformatted %>
                <span class="setup-danger">No filesystem: it will be formatted (ext4) and mounted</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <% if pools.any? %>
      <p class="setup-hint">The drives that belong to <%= pools_named %> aren't listed. <%= import_hint %></p>
    <% end %>

    <p class="setup-hint">
      ⚠ Formatting erases everything on a drive. A drive with no filesystem is always formatted; one
      that has a filesystem is formatted only if you tick its Format box.
    </p>

    <div class="setup-actions">
      <a href="<%= setup_greyhole_path %>" class="btn-skip">Skip</a>
      <button type="submit" class="btn-kai">Prepare drives &amp; continue →</button>
    </div>
  </form>
<% else %>
  <div class="setup-facts setup-center">
    <% if pools.any? %>
      <span>The other drives belong to <%= pools_named %> and are left as they are.</span>
      <span class="setup-hint"><%= import_hint %></span>
    <% else %>
      <span>No drives found besides the one the system runs from.</span>
      <span class="setup-hint">You can add drives later on Disks → Devices.</span>
    <% end %>
  </div>
  <div class="setup-actions">
    <a href="<%= setup_greyhole_path %>" class="btn-kai">Continue →</a>
  </div>
<% end %>

<%= render 'shared/install_terminal', id: 'prepare-drives', title: 'Preparing Drives', stream_url: '' %>

<div id="preview-modal" class="setup-modal" hidden>
  <div class="setup-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="preview-title">
    <div class="setup-modal-head">
      <strong id="preview-title">Drive preview</strong>
      <button type="button" class="setup-modal-close" data-call="closePreview" aria-label="Close">✕</button>
    </div>
    <div id="preview-body" class="setup-modal-body">
      <div class="preview-loading">Loading…</div>
    </div>
  </div>
</div>
