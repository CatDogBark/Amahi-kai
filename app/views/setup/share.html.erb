<h2>Create your first share</h2>
<p>
  A share is a folder on your server that every computer on your network can open. Give it a name
  and Amahi-kai sets up the rest.
</p>

<%= form_tag(setup_create_share_path, method: :post) do %>
  <label for="share_name">Share name</label>
  <input type="text" name="share_name" id="share_name" value="<%= params[:share_name] %>" placeholder="e.g. Documents, Media, Photos" maxlength="32">
  <p class="setup-hint" style="margin-top: -10px;">
    Your computers open it at <code>\\<em>server</em>\<em>name</em></code>.
  </p>

  <div class="setup-actions">
    <a href="<%= setup_complete_path %>" class="btn-skip">Skip</a>
    <button type="submit" class="btn-kai">Create &amp; continue →</button>
  </div>
<% end %>
