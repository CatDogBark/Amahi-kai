<%# The Trash (TrashController): every share's deleted files %>
<div class="file-browser" id="trash">
  <div class="fb-toolbar">
    <div class="fb-breadcrumbs">
      <a href="<%= file_browser_index_path %>" class="fb-crumb"><%= t('shares') %></a>
      <span class="fb-crumb-sep"><%= lucide_icon('chevron-right', size: 18) %></span>
      <span class="fb-crumb-current"><%= t('trash') %></span>
    </div>
    <div class="fb-actions">
      <% if @trash[:count].positive? %>
        <%= button_to 'Empty trash', trash_empty_path, method: :post, form: { class: 'd-inline-flex' },
              class: 'btn btn-sm btn-outline-danger', id: 'empty-trash',
              data: { confirm: "Delete all #{pluralize(@trash[:count], 'file')} in the trash for good? This frees #{number_to_human_size(@trash[:space])}.",
                      disable_with: 'Emptying…' } %>
      <% end %>
    </div>
  </div>

  <div class="d-flex flex-wrap align-items-center gap-2 px-2 pt-2 mb-2 small" id="trash-about">
    <span class="text-muted flex-grow-1">
      What's deleted from a share comes here. Restore puts a file back where it was.
      <% if @days.zero? %>
        Files stay until the trash is emptied.
      <% else %>
        Files are deleted for good after <%= pluralize(@days, 'day') %> here.
      <% end %>
    </span>
    <%= form_with url: trash_keep_path, method: :post, class: 'd-inline-flex align-items-center gap-1', id: 'trash-keep' do %>
      <label for="trash-days" class="text-muted">Keep files</label>
      <select name="days" id="trash-days" class="form-select form-select-sm w-auto" onchange="this.form.requestSubmit()">
        <% Trash::DAY_CHOICES.each do |choice| %>
          <option value="<%= choice %>" <%= 'selected' if choice == @days %>><%= choice.zero? ? 'until emptied' : "for #{choice} days" %></option>
        <% end %>
      </select>
      <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">Save</button></noscript>
    <% end %>
  </div>

  <div class="fb-panel">
    <% if @trash[:count].zero? %>
      <div class="fb-empty" id="trash-summary"><div class="fb-empty-icon"><%= lucide_icon('trash-2', size: 44) %></div><p>The trash is empty.</p></div>
    <% else %>
      <table class="table fb-table">
        <thead>
          <tr>
            <th class="fb-icon-col"></th>
            <th class="fb-name-col">File</th>
            <th class="fb-size-col">Size</th>
            <th class="fb-date-col">In the trash since</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @trash[:items].each do |item| %>
            <% item_params = { kind: item.kind, share: item.share, path: item.path } %>
            <tr class="fb-row trash-item">
              <td class="fb-icon-col"><span class="fb-item-icon"><%= lucide_icon(FileBrowserService::KIND_ICONS[FileBrowserService.kind(FileBrowserService.detect_mime_type(item.path), false)], size: 18) %></span></td>
              <td class="fb-name-col text-break">
                <span class="text-muted"><%= item.share %>/</span><%= item.path %>
                <% if item.copies > 1 %><span class="small text-muted ms-1">(<%= item.copies %> copies)</span><% end %>
              </td>
              <td class="fb-size-col"><%= number_to_human_size(item.bytes) %></td>
              <td class="fb-date-col"><%= relative_time_tag(item.trashed_at, capitalize: true) %></td>
              <td class="text-end text-nowrap">
                <% if item.kind == :share || @pooled_shares.include?(item.share) %>
                  <%= button_to 'Restore', trash_restore_path, method: :post, params: item_params,
                        form: { class: 'd-inline-flex' }, class: 'btn btn-sm btn-outline-primary me-1',
                        data: { disable_with: 'Restoring…' } %>
                <% else %>
                  <span class="small text-muted me-2">Its share isn't pooled now</span>
                <% end %>
                <%= button_to 'Delete', trash_delete_path, method: :post, params: item_params,
                      form: { class: 'd-inline-flex' }, class: 'btn btn-sm btn-outline-secondary',
                      data: { confirm: "Delete #{item.share}/#{item.path} for good?", disable_with: 'Deleting…' } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>

  <div class="fb-statusbar" id="trash-summary-bar">
    <% if @trash[:count].positive? %>
      <%= pluralize(@trash[:count], 'file') %>, using <%= number_to_human_size(@trash[:space]) %> (every copy counted)<% if @trash[:count] > @trash[:items].size %>; the newest <%= @trash[:items].size %> are listed<% end %>
    <% end %>
  </div>
  </div>
</div>
