<%# The Trash (TrashController): what Greyhole keeps of files deleted or changed in pooled shares %>
<div class="file-browser" id="trash">
  <div class="fb-header">
    <div class="fb-breadcrumbs">
      <a href="<%= file_browser_index_path %>" class="fb-crumb"><%= t('shares') %></a>
      <span class="fb-crumb-sep">/</span>
      <span class="fb-crumb-current"><%= t('trash') %></span>
    </div>
    <div class="fb-actions">
      <% if @greyhole_installed && @trash[:count].positive? %>
        <%= button_to 'Empty trash', trash_empty_path, method: :post, form: { class: 'd-inline-flex' },
              class: 'btn btn-sm btn-outline-danger', id: 'empty-trash',
              data: { confirm: "Delete all #{pluralize(@trash[:count], 'file')} in the trash for good? This frees #{number_to_human_size(@trash[:space])} on the pool drives.",
                      disable_with: 'Emptying…' } %>
      <% end %>
    </div>
  </div>

  <p class="small text-muted px-2 pt-2 mb-2" id="trash-about">
    When a file in a pooled share is deleted, or changed, Greyhole keeps the old copy here until the trash is emptied.
    Restore puts a file back where it was, and Greyhole makes its copies again. Shares that aren't pooled have no trash:
    what's deleted from them is gone.
  </p>

  <div class="fb-listing">
    <% if !@greyhole_installed %>
      <div class="fb-empty"><div class="fb-empty-icon">🗑</div><p>Greyhole isn't installed, so there's no trash.</p></div>
    <% elsif @trash[:count].zero? %>
      <div class="fb-empty" id="trash-summary"><div class="fb-empty-icon">🗑</div><p>The trash is empty.</p></div>
    <% else %>
      <table class="table fb-table">
        <thead>
          <tr>
            <th class="fb-icon-col"></th>
            <th class="fb-name-col">File</th>
            <th class="fb-size-col">Size</th>
            <th class="fb-date-col">In the trash since</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @trash[:items].each do |item| %>
            <tr class="fb-row trash-item">
              <td class="fb-icon-col"><%= FileBrowserService.file_icon(item.path, false) %></td>
              <td class="fb-name-col text-break">
                <span class="text-muted"><%= item.share %>/</span><%= item.path %>
                <% if item.copies > 1 %><span class="small text-muted ms-1">(<%= item.copies %> copies)</span><% end %>
              </td>
              <td class="fb-size-col"><%= number_to_human_size(item.bytes) %></td>
              <td class="fb-date-col"><%= relative_time_tag(item.trashed_at, capitalize: true) %></td>
              <td class="text-end text-nowrap">
                <% if @pooled_shares.include?(item.share) %>
                  <%= button_to 'Restore', trash_restore_path, method: :post, params: { share: item.share, path: item.path },
                        form: { class: 'd-inline-flex' }, class: 'btn btn-sm btn-outline-primary me-1',
                        data: { disable_with: 'Restoring…' } %>
                <% else %>
                  <span class="small text-muted me-2">Its share isn't pooled now</span>
                <% end %>
                <%= button_to 'Delete', trash_delete_path, method: :post, params: { share: item.share, path: item.path },
                      form: { class: 'd-inline-flex' }, class: 'btn btn-sm btn-outline-secondary',
                      data: { confirm: "Delete #{item.share}/#{item.path} for good?", disable_with: 'Deleting…' } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="fb-statusbar" id="trash-summary-bar">
    <% if @greyhole_installed && @trash[:count].positive? %>
      <%= pluralize(@trash[:count], 'file') %>, using <%= number_to_human_size(@trash[:space]) %> on the pool drives (every copy counted)<% if @trash[:count] > @trash[:items].size %>; the newest <%= @trash[:items].size %> are listed<% end %>
    <% end %>
  </div>
</div>
