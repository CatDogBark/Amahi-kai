/ One app of the catalog (AppCatalog), installed (a DockerApp) or not. The root helper does
/ the work (docs/plans/apps.md); the buttons post to the apps actions and the page reloads.
- installed = app.is_a?(DockerApp)
- identifier = installed ? app.identifier : app[:identifier]
- name = installed ? app.name : app[:name]
- description = installed ? app.description : app[:description]
- category = installed ? app.category : app[:category]
- logo = installed ? app.logo_url : app[:logo_url]
- status = installed ? app.status : 'available'
- entry = AppCatalog.find(identifier) || {}
/ The share dialog (_shares_dialog, apps.js) opens from buttons carrying these; it then installs.
- share_dialog = { 'app-shares' => identifier, 'app-name' => name, 'url' => apps_docker_install_stream_path(identifier),
                   'writes' => entry[:writes_shares].to_s, 'current' => (installed ? app.shares : []).to_json }
- data_path = File.join(AppCatalog.apps_root, identifier)
- uninstall_note = "Uninstall #{name}? Its data stays in #{data_path} and is used again if you install it later."

.app.docker-app id="docker_app_#{identifier}"
  table.settings.stretchtoggle
    tr.hover-style
      td.settings-col1.settings-col1-pad1.apps-col1 style="vertical-align:middle"
        .d-flex.align-items-center
          - if logo.present?
            img.me-2 src=logo style="width:32px;height:32px;border-radius:4px;object-fit:contain" alt=name onerror="this.outerHTML='<span class=\'me-2 d-inline-flex align-items-center justify-content-center bg-secondary text-white rounded\' style=\'width:32px;height:32px;font-size:14px;\'>📦</span>'"
          span.fw-bold= name
          - if category.present?
            span.badge.bg-secondary.ms-2.small= category
      td.settings-col2.ps-2.apps-col2.text-secondary style="vertical-align:middle"
        = description.present? ? truncate(description, length: 120) : t('no_description_supplied')
        - if installed && app.ports.any?
          .small.mt-1
            = app.ports.map { |port| port[:host] }.uniq.one? ? 'Port ' : 'Ports '
            = app.port_summary
        - if installed && %w[running stopped].include?(status)
          / Versions (P4.5): Update when the catalog has another one, Undo update while the copy
          / from before the last update is kept. Both run in the install window (apps.js).
          - backup = AppCatalog.backup(identifier)
          .small.mt-1
            = "Version #{app.version}"
            - if app.update_available? && entry[:installable] == false
              span.text-warning.ms-2 = "#{app.catalog_version} needs a newer Amahi-kai: run System Update first"
            - elsif app.update_available?
              - target = app.catalog_version
              button.btn.btn-link.p-0.ms-2.align-baseline.fw-semibold type="button" style="font-size: inherit" data-app-stream=identifier data-url=apps_docker_update_stream_path(identifier) data-title="Updating #{name}..." data-confirm="Update #{name} to #{target}? It stops for a minute or two. A copy of its data is kept for #{AppCatalog::BACKUP_DAYS} days, and if #{target} doesn't come up, #{name} goes back to #{app.version} by itself." = "Update to #{target}"
              - releases = AppCatalog.releases_url(identifier, entry[:image])
              - if releases
                a.ms-2 href=releases target="_blank" rel="noopener" What's new
            - if backup
              button.btn.btn-link.p-0.ms-2.align-baseline type="button" style="font-size: inherit" data-app-stream=identifier data-url=apps_docker_undo_update_stream_path(identifier) data-title="Undoing #{name}'s update..." data-confirm="Undo the update? #{name} goes back to #{AppCatalog.tag(backup[:from])} with its data from #{l(backup[:taken_at], format: :short)}. Anything changed in #{name} since then is lost." Undo update
              span.text-secondary.ms-1 = "(until #{backup[:until].localtime.strftime('%B %-d')})"
          .small.mt-1
            = app.shares.any? ? "Shares #{app.share_summary}" : 'No shares'
            button.btn.btn-link.p-0.ms-2.align-baseline type="button" style="font-size: inherit" data=share_dialog.merge('verb' => 'Save and restart') Change
        - if status == 'error' && installed && app.error_message.present?
          .small.text-danger.mt-1 = app.error_message
        - if status == 'available' && AppCatalog.data_kept?(identifier)
          .small.mt-1
            | Its data from an earlier install is kept and used again.
            button.btn.btn-link.p-0.ms-1.text-danger.align-baseline type="button" style="font-size: inherit" onclick="if(confirm(#{"Delete #{name}'s data in #{data_path}? This can't be undone.".to_json})){dockerAppAction('/apps/docker/uninstall/#{identifier}?delete_data=1', this)}" Delete it
      td.text-end.pe-3.text-nowrap style='width: 240px; vertical-align:middle'
        - case status
        - when 'available'
          - if entry[:installable] == false
            span.small.text-warning Needs a newer Amahi-kai: run System Update first
          - else
            button.btn.btn-sm.btn-primary type="button" data=share_dialog.merge('verb' => 'Install')
              = t('install', default: 'Install')
        - when 'pulling', 'installing'
          span.badge.bg-warning.text-dark
            span.spinner-border.spinner-border-sm.me-1
            | Installing
        - when 'running'
          .d-flex.gap-1.justify-content-end
            - if app.url(request.host) && via_tunnel?
              span.small.text-secondary.me-1.align-self-center Open it on your LAN or Tailscale
            - elsif app.url(request.host)
              a.btn.btn-sm.btn-success href=app.url(request.host) target="_blank" rel="noopener" Open
            button.btn.btn-sm.btn-outline-danger onclick="dockerAppAction('/apps/docker/stop/#{identifier}', this)" Stop
            button.btn.btn-sm.btn-outline-secondary onclick="if(confirm(#{uninstall_note.to_json})){dockerAppAction('/apps/docker/uninstall/#{identifier}', this)}" Uninstall
        - when 'stopped'
          .d-flex.gap-1.justify-content-end
            button.btn.btn-sm.btn-outline-success onclick="dockerAppAction('/apps/docker/start/#{identifier}', this)" Start
            button.btn.btn-sm.btn-outline-secondary onclick="if(confirm(#{uninstall_note.to_json})){dockerAppAction('/apps/docker/uninstall/#{identifier}', this)}" Uninstall
        - when 'error'
          .d-flex.gap-1.align-items-center.justify-content-end
            span.badge.bg-danger Error
            button.btn.btn-sm.btn-outline-primary type="button" data=share_dialog.merge('verb' => 'Install again') Install again
            button.btn.btn-sm.btn-outline-secondary onclick="if(confirm(#{uninstall_note.to_json})){dockerAppAction('/apps/docker/uninstall/#{identifier}', this)}" Uninstall
    - secrets = installed ? AppCatalog.secrets(identifier) : []
    - if secrets.any?
      tr
        td colspan="3"
          details.app-secrets.ps-3.pb-2
            summary.small Passwords and keys Amahi-kai made for #{name}
            table.table.table-sm.small.mb-0.mt-1
              - secrets.each do |secret|
                tr
                  td.text-muted style="width: 40%" = secret[:label]
                  td
                    code.me-2 = secret[:value]
                    button.btn.btn-sm.btn-outline-secondary.py-0 type="button" data-copy=secret[:value] Copy
