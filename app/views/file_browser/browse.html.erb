<%# The web file browser only views and downloads. Files are added, renamed and deleted over
    the SMB share, so Samba, and Greyhole on pooled shares, sees every change. A whole row is
    the link: a folder opens, a file shows in the panel beside the list (file_browser_controller.js). %>
<% folder_path = ->(name) { [@relative_path, name].reject(&:blank?).join('/') } %>
<div class="file-browser" data-controller="file-browser">

  <div class="fb-toolbar">
    <nav class="fb-breadcrumbs" aria-label="Folder">
      <a href="<%= file_browser_index_path %>" class="fb-crumb" id="fb-shares-crumb"><%= t('shares') %></a>
      <% @breadcrumbs.each_with_index do |crumb, i| %>
        <span class="fb-crumb-sep"><%= lucide_icon('chevron-right', size: 18) %></span>
        <% if i == @breadcrumbs.length - 1 %>
          <span class="fb-crumb-current" aria-current="page"><%= crumb[:name] %></span>
        <% else %>
          <a href="<%= browse_path(@share, crumb[:path]) %>" class="fb-crumb"><%= crumb[:name] %></a>
        <% end %>
      <% end %>
    </nav>
    <div class="fb-actions">
      <% if @entries.any? %>
        <div class="fb-viewtoggle" role="group" aria-label="View">
          <button type="button" class="fb-viewbtn" data-view="list" aria-pressed="true" aria-label="List" data-action="click->file-browser#setView"><%= lucide_icon('list', size: 17) %></button>
          <button type="button" class="fb-viewbtn" data-view="grid" aria-pressed="false" aria-label="Grid" data-action="click->file-browser#setView"><%= lucide_icon('layout-grid', size: 17) %></button>
        </div>
        <a class="btn btn-sm btn-outline-info fb-download-folder" id="fb-download-folder" href="<%= @relative_path.present? ? file_browser_download_path(@share, path: @relative_path) : file_browser_download_root_path(@share) %>"
           data-action="click->file-browser#downloadZip" data-zip-name="<%= @breadcrumbs.last[:name] %>">
          <%= lucide_icon('download', size: 16) %> Download folder
        </a>
      <% end %>
      <%# Says the zip is being made until the download starts (the browser then shows its progress) %>
      <span class="fb-download-status small" id="fb-download-status" data-file-browser-target="downloadStatus" role="status" hidden></span>
    </div>
  </div>

  <div class="fb-body">
    <section class="fb-panel fb-listing" data-file-browser-target="listing" aria-label="Files">
      <% if @entries.empty? %>
        <div class="fb-empty">
          <div class="fb-empty-icon"><%= lucide_icon('folder', size: 44) %></div>
          <% if @relative_path.blank? %>
            <p>This share is empty</p>
            <p class="text-muted">Add files over the network share (SMB) and they show up here.</p>
          <% else %>
            <p>This folder is empty</p>
          <% end %>
        </div>
      <% else %>
        <div class="fb-list-head" aria-hidden="true">
          <span></span><span>Name</span><span class="fb-item-size">Size</span><span class="fb-item-date">Modified</span><span></span>
        </div>
        <div class="fb-items" role="list">
          <% if @relative_path.present? %>
            <div class="fb-item fb-item-parent" role="listitem">
              <a class="fb-item-main" href="<%= browse_path(@share, @relative_path.split('/')[0...-1].join('/')) %>">
                <span class="fb-item-icon"><%= lucide_icon('folder', size: 18) %></span>
                <span class="fb-item-name">..</span>
                <span class="fb-item-size"></span><span class="fb-item-date">Up a folder</span>
              </a>
            </div>
          <% end %>
          <% @entries.each do |entry| %>
            <% path = folder_path.call(entry[:name]) %>
            <% kind = entry[:kind] %>
            <div class="fb-item" role="listitem" data-name="<%= entry[:name] %>" data-directory="<%= entry[:directory] %>">
              <% if entry[:directory] %>
                <a class="fb-item-main fb-folder-link" href="<%= browse_path(@share, path) %>" data-kind="folder">
              <% else %>
                <a class="fb-item-main fb-file-link" href="<%= file_browser_raw_path(@share, path: path) %>" data-kind="<%= kind %>"
                   data-action="click->file-browser#select"
                   data-name="<%= entry[:name] %>" data-kind-name="<%= FileBrowserService::KIND_NAMES[kind] %>"
                   data-raw-url="<%= file_browser_raw_path(@share, path: path) %>"
                   data-download-url="<%= file_browser_download_path(@share, path: path) %>"
                   data-size="<%= number_to_human_size(entry[:size]) if entry[:size] %>"
                   data-modified="<%= entry[:modified]&.strftime('%b %-d, %Y · %H:%M') %>">
              <% end %>
                <span class="fb-item-icon fb-kind-<%= kind %>"><%= lucide_icon(FileBrowserService::KIND_ICONS[kind], size: 18) %></span>
                <span class="fb-item-name"><%= entry[:name] %></span>
                <span class="fb-item-size"><%= entry[:size] ? number_to_human_size(entry[:size]) : '' %></span>
                <span class="fb-item-date"><%= entry[:modified]&.strftime('%b %-d, %Y · %H:%M') %></span>
              </a>
              <a class="fb-item-download" href="<%= file_browser_download_path(@share, path: path) %>"
                 aria-label="<%= entry[:directory] ? "Download #{entry[:name]} as a zip" : "Download #{entry[:name]}" %>"
                 <% if entry[:directory] %>data-action="click->file-browser#downloadZip" data-zip-name="<%= entry[:name] %>"<% end %>>
                <%= lucide_icon('download', size: 16) %>
              </a>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="fb-statusbar">
        <%= pluralize(@entries.count { |e| e[:directory] }, 'folder') %>,
        <%= pluralize(@entries.count { |e| !e[:directory] }, 'file') %>
        <% total = @entries.sum { |e| e[:size] || 0 } %>
        <% if total > 0 %>(<%= number_to_human_size(total) %>)<% end %>
      </div>
    </section>

    <aside class="fb-panel fb-details" data-file-browser-target="details" aria-label="Selected file" aria-live="polite">
      <p class="fb-details-empty">Click a file to see it here, and again to close it. Clicking a folder opens it.</p>
    </aside>
  </div>

  <%# ── Full-screen preview ── %>
  <div class="modal fade" id="previewModal" tabindex="-1" data-file-browser-target="previewModal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content fb-modal">
        <div class="modal-header border-0">
          <h5 class="modal-title" data-file-browser-target="previewTitle"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center p-2" data-file-browser-target="previewBody"></div>
        <div class="modal-footer border-0">
          <a href="#" class="btn btn-sm btn-info" data-file-browser-target="previewDownload"><%= lucide_icon('download', size: 14) %> Download</a>
        </div>
      </div>
    </div>
  </div>
</div>
