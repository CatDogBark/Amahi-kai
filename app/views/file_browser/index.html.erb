<%# Files → Shares: the shares this person can open, as cards, and (admins) the Trash below them %>
<div class="file-browser fb-root">
  <% if @shares.empty? %>
    <div class="fb-empty">
      <div class="fb-empty-icon"><%= lucide_icon('folder', size: 44) %></div>
      <p>There are no shares you can open.</p>
      <% if current_user_is_admin? %>
        <p class="text-muted">Make one on Setup → Shares.</p>
      <% else %>
        <p class="text-muted">An administrator can give you access to one.</p>
      <% end %>
    </div>
  <% else %>
    <div class="fb-cards" id="share-list">
      <% @shares.each do |share| %>
        <% copies = share.disk_pool_copies.to_i %>
        <a class="fb-card" href="<%= file_browser_path(share) %>">
          <span class="fb-card-top">
            <span class="fb-card-icon<%= ' fb-accent' if copies.positive? %>"><%= lucide_icon('folder', size: 24) %></span>
            <% if copies.positive? %>
              <span class="fb-chip fb-chip-accent">Pool · <%= pluralize(copies, 'copy') %></span>
            <% elsif share.rdonly %>
              <span class="fb-chip">Read only</span>
            <% end %>
          </span>
          <span class="fb-card-name"><%= share.name %></span>
          <span class="fb-card-meta">
            <%= @counts[share.id] ? pluralize(@counts[share.id], 'item') : '' %>
          </span>
          <span class="fb-card-address"><%= path2location(share.name) %></span>
        </a>
      <% end %>
    </div>
  <% end %>

  <% if @trash %>
    <%# Set apart from the shares: every share's deleted files %>
    <a class="fb-trash-strip" href="<%= trash_path %>" id="trash-entry">
      <span class="fb-card-icon"><%= lucide_icon('trash-2', size: 22) %></span>
      <span class="fb-trash-text">
        <span class="fb-trash-title"><%= t('trash') %>
          <span class="fb-trash-count" id="trash-entry-summary"><%= @trash[:count].zero? ? 'empty' : "#{pluralize(@trash[:count], 'file')} · #{number_to_human_size(@trash[:space])}" %></span>
        </span>
        <span class="fb-trash-about">Deleted files wait here for <%= Trash.days.zero? ? 'as long as you like' : pluralize(Trash.days, 'day') %>, in case you want them back.</span>
      </span>
      <span class="fb-trash-open">Open Trash</span>
    </a>
  <% end %>
</div>
