/! A user's new password: Change password opens the fields (data-reveal), Cancel closes and clears
/! them (data-reveal-hide), and user_controller.js sends them.
form.update-password.update-form[
  action=update_password_user_path(user)
  method="post"
  id="edit_user_password_#{user.id}"
  data-user-target="passwordForm"
  data-action="submit->user#submitPassword"]
  input type="hidden" name="_method" value="put"
  input type="hidden" name="authenticity_token" value=form_authenticity_token
  button.btn.btn-sm.btn-outline-info[type="button" id="user-password-control-action-#{user.id}" data-reveal=".password-edit"] Change password
  .password-edit.mt-2 style="display:none"
    .d-flex.flex-wrap.gap-2
      input.form-control.form-control-sm[type="password" name="user[password]" id="password_#{user.id}" maxlength="128" minlength="8" placeholder="New password" autocomplete="new-password" style="max-width: 14rem"]
      input.form-control.form-control-sm[type="password" name="user[password_confirmation]" id="password_confirmation_#{user.id}" maxlength="128" minlength="8" placeholder="The same again" autocomplete="new-password" style="max-width: 14rem"]
    .d-flex.align-items-center.gap-2.mt-2
      = spinner
      button.btn.btn-info.btn-sm type="submit" id="submit_password_#{user.id}" Save
      a.cancel-btn-style[href="#" data-reveal-hide=".password-edit"]= t('cancel')
  / Outside .password-edit, which closes on success, so the confirmation stays visible.
  .messages data-user-target="passwordMessage"
