div.settings-fields.settings-wrap.bg-white.p-2.mb-2
  fieldset
    legend
      = t 'global_settings'
    table
      tr
        td.pe-3
          label = t 'advanced_settings'
        td
          input.form-check-input type="checkbox" id="advanced" autocomplete="off" checked=advanced? data-call="toggleAdvanced" data-args='["#{toggle_advanced_path}"]'

div.settings-fields.settings-wrap.bg-white.p-2
  fieldset
    legend
      = t 'system_info'
    div.settings-actions.d-flex.gap-2
      = button_to settings_poweroff_path, id: 'btn-poweroff', class: 'btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1', form: { onsubmit: "return confirm(#{t('this_will_power_off').to_json})" } do
        = lucide_icon('power', size: 16)
        = t('poweroff')
      = button_to settings_reboot_path, id: 'btn-reboot', class: 'btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1', form: { onsubmit: "return confirm(#{t('this_will_reboot').to_json})" } do
        = lucide_icon('refresh-cw', size: 16)
        = t('reboot')
    div.settings-fields#info-table
      table
        tr
          td.pe-3
            label = t 'system'
          td
            = "#{SystemInfo.kernel}, #{SystemInfo.machine}"
        tr
          td.pe-3
            label = t 'platform'
          td = @version[:platform]
        tr
          td.pe-3
            label = t 'core'
          td = @version[:core]
        tr
          td.pe-3
            label = t 'uptime'
          td = "up #{SystemInfo.uptime}"

= javascript_include_tag 'settings'
