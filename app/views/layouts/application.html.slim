doctype 5
/ Dark for everyone: the water background is made for it.
html[lang="en" data-theme="dark" data-bs-theme="dark"]
  head
    meta charset="utf-8"
    / Without it a phone lays the page out at desktop width, and the header's phone menu never shows.
    meta content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport" /
    link rel="icon" type="image/svg+xml" href="/favicon.svg"
    link rel="alternate icon" href="/favicon.ico"
    title = full_page_title

    = stylesheet_link_tag 'application'

    = javascript_include_tag 'application'

    = csrf_meta_tags
    / When this page's sign-in ends unless it's used: the page goes to the sign-in page then
    / (session_watch.js), asking this address, which doesn't count as use.
    - if current_user
      meta name="amahi-session" content=session_status_path data-ends-in=session_ends_in

  body data-form-reply=form_reply_attribute

    == render 'layouts/ocean_bg'
    = render 'layouts/header'

    #content
      = render 'layouts/subheader'
      = render 'shared/flash_messages'
      #app.inner.container
        - unless @no_tabs
          = render 'shared/tabs'
        #preferences
          .preftab
              = yield
      .push
    = render 'layouts/footer'

    - if current_user_is_admin?
      == render 'layouts/system_update'

