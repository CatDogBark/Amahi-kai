/! The header: Amahi-kai, its sections (the current one marked), search, and the tools. On a
/! phone the sections and Help fold into the menu below.
- section = page_section
nav.navbar.navbar-expand-md.kai-header
  .container.kai-header-inner
    a.kai-brand href="/"
      = lucide_icon('waves', size: 22)
      span Amahi-kai

    - if current_user
      .kai-mainnav.d-none.d-md-flex
        a.kai-navlink href="/" aria-current=("page" if section == :dashboard) = t('dashboard')
        - if current_user.can_browse?
          a.kai-navlink#files-link href=file_browser_index_path aria-current=("page" if section == :files) Files
        - if current_user_is_admin?
          a.kai-navlink href=apps_index_path aria-current=("page" if section == :apps) = t('apps')
          a.kai-navlink href=users_path aria-current=("page" if section == :setup) = t('setup')

    - if current_user&.can_browse?
      = render 'layouts/searchform'

    .kai-header-tools
      - if current_user_is_admin?
        /! Opens the System Update dialog (layouts/_system_update); the dot says an update is
        /! waiting, for Amahi-kai or an app.
        - waiting = update_waiting
        a.kai-iconbtn#update-btn href="#" data-tip=waiting[:label] data-tip-placement="bottom" aria-label=waiting[:label] data-whats-new=""
          = lucide_icon('refresh-cw', size: 17)
          - if waiting[:dot]
            span.update-dot
      /! The water background's settings (ocean.js opens its panel)
      button.kai-iconbtn.ocean-toggle type="button" data-ocean-panel="" data-tip="Water background" data-tip-placement="bottom" aria-label="Water background" aria-expanded="false"
        = lucide_icon('waves', size: 17)
      a.kai-iconbtn.d-none.d-md-inline-flex href="https://amahi-kai.com/wiki/" target="_blank" rel="noopener" data-tip=t('help') data-tip-placement="bottom" aria-label=t('help')
        = lucide_icon('help-circle', size: 17)
      - if current_user_is_admin?
        a.kai-iconbtn#advanced-toggle href="#" class=("active" if @advanced) data-tip=t('advanced_settings') data-tip-placement="bottom" aria-label=t('advanced_settings') aria-pressed=(@advanced ? 'true' : 'false') onclick="fetch('#{toggle_advanced_path}', {method:'POST', headers:{'X-CSRF-Token':document.querySelector('meta[name=csrf-token]').content}}).then(function(){location.reload()});return false;"
          = lucide_icon('wrench', size: 17)
      - if current_user
        button.navbar-toggler.kai-iconbtn.d-md-none type="button" data-bs-target="#amahi-nav" data-bs-toggle="collapse" aria-controls="amahi-nav" aria-expanded="false" aria-label="Menu"
          span.navbar-toggler-icon

    - if current_user
      #amahi-nav.collapse.kai-mobile-collapse
        .kai-mobilenav
          a.kai-navlink href="/" aria-current=("page" if section == :dashboard) = t('dashboard')
          - if current_user.can_browse?
            a.kai-navlink href=file_browser_index_path aria-current=("page" if section == :files) Files
          - if current_user_is_admin?
            a.kai-navlink href=apps_index_path aria-current=("page" if section == :apps) = t('apps')
            a.kai-navlink href=users_path aria-current=("page" if section == :setup) = t('setup')
          a.kai-navlink href="https://amahi-kai.com/wiki/" target="_blank" rel="noopener" = t('help')
