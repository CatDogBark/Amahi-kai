footer#footer.container-fluid.py-2
    .container
      .d-flex.justify-content-center
        .d-none.d-md-block.d-lg-block
          span.mx-2 
            | &copy; #{Date.today.year} Amahi-kai
          span.mx-2
            | Built on #{link_to "Amahi", "https://www.amahi.org", :target => "_blank"}
          span.mx-2 
            = link_to t('wiki'), 'https://amahi-kai.com/wiki/', :target=>'_blank'
          span.mx-2 
            = link_to t('troubleshoot'), 'https://amahi-kai.com/wiki/getting-started#troubleshooting', :target=>'_blank'
          
          - if current_user
            span.mx-2 
              = button_to (t('logout') + " " + current_user.login), logout_path, method: :delete, class: 'btn btn-link footer-link', form: { class: 'd-inline' }
          - else
            span.mx-2  
              = link_to t('log_in'), login_path

        .d-block.d-md-none
          .row.text-center.justify-content-center
            span.col-.mx-2
              | &copy; #{Date.today.year} Amahi-kai
            span.col-.mx-2
              | Built on #{link_to "Amahi", "https://www.amahi.org", :target => "_blank"}
          .row.text-center.justify-content-center
            span.col-.mx-2
              = link_to t('wiki'), 'https://amahi-kai.com/wiki/', :target=>'_blank'
            span.col-.mx-2
              = link_to t('troubleshoot'), 'https://amahi-kai.com/wiki/getting-started#troubleshooting', :target=>'_blank'
            - if current_user
              span.mx-2 
                = button_to (t('logout') + " " + current_user.login), logout_path, method: :delete, class: 'btn btn-link footer-link', form: { class: 'd-inline' }
            - else
              span.mx-2  
                = link_to t('log_in'), login_path
