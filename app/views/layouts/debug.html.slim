doctype 5
/ Dark for everyone: the water background is made for it.
html[lang="en" data-theme="dark" data-bs-theme="dark"]
  head
    meta charset="utf-8"
    title = full_page_title

    = stylesheet_link_tag 'application'

    /! Plugin stylesheets omitted — debug/error page should not depend on plugin assets

    = javascript_include_tag 'application'

    link rel="shortcut icon" href="/favicon.ico" type="image/x-icon"

    = csrf_meta_tags

  body.basic

    == render 'layouts/ocean_bg'
    = render 'layouts/header'

    #content
      = render 'layouts/subheader'
      = render 'shared/flash_messages'
      #app.inner
        #tabs
          nav.preftab.active
            ul
              li.active
                a href='/tab/debug'
                  = t 'debug'
                ul
                  li[class="#{request.fullpath == '/tab/debug' ? 'active' : ''}"]
                    = link_to "App Logs", '/tab/debug'
                  li[class="#{request.fullpath == '/tab/debug/logs' ? 'active' : ''}"]
                    = link_to "Logs", '/tab/debug/logs'
                  li[class="#{request.fullpath == '/tab/debug/system' ? 'active' : ''}"]
                    = link_to "System Info", '/tab/debug/system'
        #preferences
          .preftab
            = yield

    = render 'layouts/footer'

    - if current_user_is_admin?
      == render 'layouts/system_update'

