<!DOCTYPE html>
<%# The first-run setup wizard: one glass panel on the water, in the app's look (application.css,
    then setup.css). Dark for everyone: the water background is made for it. %>
<%
  steps = [%w[welcome Welcome], %w[admin Password], %w[network Network], %w[storage Drives],
           %w[greyhole Pooling], %w[share Share], %w[complete Done]]
  # update_admin and create_share render their own step again when they refuse
  step = steps.index { |key, _| key == controller.action_name.delete_prefix('update_').delete_prefix('create_') }
%>
<html lang="en" data-theme="dark" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Amahi-kai Setup</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.ico">
  <%= stylesheet_link_tag "application" %>
  <%= stylesheet_link_tag "setup" %>
  <%= javascript_include_tag "ocean" %>
  <%= javascript_include_tag "setup" %>
  <%= csrf_meta_tags %>
</head>
<body class="setup-page"<%= ' data-form-reply' if form_reply_attribute %>>
  <%= render 'layouts/ocean_bg' %>
  <main class="setup-shell">
    <div class="setup-top">
      <span class="kai-brand"><%= lucide_icon('waves', size: 22) %><span>Amahi-kai</span></span>
      <span class="setup-stepcount">
        <% if step %>Step <%= step + 1 %> of <%= steps.size %><% else %>First-run setup<% end %>
      </span>
    </div>
    <% if step %>
      <div class="setup-progress" aria-hidden="true">
        <% steps.each_index do |i| %>
          <div class="step<%= ' done' if i < step %><%= ' current' if i == step %>"></div>
        <% end %>
      </div>
    <% end %>
    <div class="setup-container">
      <div class="setup-body">
        <% if step && !%w[welcome complete].include?(steps[step][0]) %>
          <div class="setup-eyebrow"><%= steps[step][1] %></div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </main>
<%= render 'shared/flash_messages' %>
</body>
</html>
