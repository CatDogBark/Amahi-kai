/! The page's title, with its section above it (Setup, Files) where it has one. The dashboard
/! has its own welcome instead.
- unless page_section == :dashboard
  - section = { setup: 'Setup', files: 'Files' }[page_section]
  .container.kai-pagehead
    - if section
      .kai-eyebrow = section
    /! A page with its own heading (the file browser's breadcrumbs) sets @page_heading = false
    - if page_title && @page_heading != false
      h1.kai-page-title = page_title
