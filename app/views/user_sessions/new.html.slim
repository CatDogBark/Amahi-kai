#login
  #logo
    a.kai-brand href="/"
      = lucide_icon('waves', size: 26)
      span Amahi-kai

  - flash.each do |name, msg|
    div class="alert alert-#{name}" role=("alert" if %w[danger error].include?(name.to_s)) = msg

  .login-panel
    = form_for @user_session do |f|
      label for="username" = t('username')
      = text_field_tag 'username', @login, autofocus: true, autocomplete: 'username', placeholder: t('username')
      label for="password" = t('password')
      = password_field_tag 'password', nil, autocomplete: 'current-password', placeholder: t('password')

      .login-row
        label.rememberme for="remember_me"
          = check_box_tag 'remember_me', '1', @remember_me
          span = t('remember_me')
        = submit_tag t('log_in'), class: 'btn btn-primary'
