#login
  #logo
    a[href="/"]
      = image_tag 'logo.svg', alt: 'Amahi-kai', style: 'max-height: 55px;'

  - flash.each do |name, msg|
    div[class="alert alert-#{name}"]= msg

  = form_for @user_session do |f|
    p
      = text_field_tag 'username', @login, :autofocus => true, :placeholder => t('username')
    p
      = password_field_tag 'password', nil, :placeholder => t('password')

    p[class="rememberme"]
      label[for="remember_me"]
        = check_box_tag 'remember_me', '1', @remember_me
        | &nbsp;
        = t 'remember_me'

    p[class="submit"]
      = submit_tag t('log_in')
