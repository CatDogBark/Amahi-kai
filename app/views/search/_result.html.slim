li[class="#{cycle('odd', 'even')}"]
  .search-filename
    = search_result_icon(result)
    = link_to h(result[:title]), path2uri(result[:path])
  .search-location
    small = path2location(result[:path])
    | &nbsp;&mdash;&nbsp;
    em = number_to_human_size(result[:size])
    | , 
    em = h(result[:owner])
    | &nbsp;&nbsp;
    = link_to lucide_icon('folder', size: 16), path2uri(File.dirname result[:path]), :title => t('open'), :class => 'file-icon', 'aria-label' => t('open')
