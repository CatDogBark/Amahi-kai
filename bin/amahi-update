#!/usr/bin/env bash
set -euo pipefail

# Amahi-kai Update Script
# Pulls latest code, installs dependencies, runs migrations, and restarts. If a step
# fails, or the new version doesn't answer after the restart, it goes back to the commit
# that was running.
#
# Usage: sudo /opt/amahi-kai/bin/amahi-update [--stream] [--repair]
#
# --stream: Output progress messages for SSE streaming (used by web UI)
# --repair: Run every step even if the pull brings nothing new (to fix an install). Without
#           it, an update with nothing new stops after the pull. The web UI's Repair asks the
#           root helper, which leaves /run/amahi-kai-update.repair for this script instead.
#
# System Update in the web UI starts amahi-kai-update.service (the root helper's
# system.update), which runs this script with --stream and writes its output to
# /var/log/amahi-kai/update.log; the page follows that log. Run outside amahi-kai.service
# like that, or from a terminal, the script can restart the app and check that it answers.
#
# Root owns the code (bin/amahi-set-ownership) and runs only git, this script, the helper
# installer and system commands. Everything that loads the app or its gems (bundle,
# migrations, rails runner, the asset build) runs as the app user (as_app), which can
# write vendor/bundle, so root never runs code the app user could have changed.
#
# Rollback puts the code, gems, compiled assets, helper and sudoers rules back as they
# were. The database isn't rolled back (MariaDB can't undo schema changes reliably):
# migrations must keep working with the previous version's code, and a backup of the
# database is taken before they run (/var/lib/amahi-kai/backups, the last 3 kept).

APP_DIR="${APP_DIR:-/opt/amahi-kai}"
ENV_FILE="${ENV_FILE:-/etc/amahi-kai/amahi.env}"
APP_USER="${APP_USER:-amahi}"
APP_GROUP="${APP_GROUP:-amahi}"
BACKUP_DIR="${BACKUP_DIR:-/var/lib/amahi-kai/backups}"
STREAM=false
REPAIR=false
ORIG_ARGS=("$@")
REPAIR_FLAG=/run/amahi-kai-update.repair

for arg in "$@"; do
  case "$arg" in
    --stream) STREAM=true ;;
    --repair) REPAIR=true ;;
  esac
done

log() {
  if $STREAM; then
    echo "$1"
  else
    echo "==> $1"
  fi
}

error() {
  if $STREAM; then
    echo "✗ $1"
  else
    echo "ERROR: $1" >&2
  fi
  exit 1
}

# Runs a command in the app folder as the app user, with the app's environment.
as_app() {
  sudo -u "$APP_USER" -H bash -lc "set -a && source '$ENV_FILE' && set +a && cd '$APP_DIR' && $1"
}

# Git as root, without hooks or an fsmonitor command from the checkout's own config.
root_git() {
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# Inside amahi-kai.service (an older web UI ran this script that way), restarting the app
# ends this script too, so it can't check the new version or roll back after that.
in_app_service() {
  grep -q '/amahi-kai\.service' /proc/self/cgroup 2>/dev/null
}

# Whether the app answers on its port (local requests skip the host allowlist).
app_answers() {
  local i
  for i in $(seq 1 45); do
    if curl -fsS -o /dev/null --max-time 5 "http://127.0.0.1:${PORT:-3000}/login" 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

restart_app() {
  systemctl restart amahi-kai 2>&1 && app_answers
}

# Puts the previous commit back and stops. $1 names the step that failed; $2 is "restarted"
# once the new version has been restarted, so the previous one has to be restarted too.
rollback() {
  local step="$1" restarted="${2:-}"
  if [[ -z "${PREV:-}" || "$(root_git -C "$APP_DIR" rev-parse HEAD)" == "$PREV" ]]; then
    if [[ -n "$restarted" ]]; then
      error "$step failed: Amahi-kai didn't answer after the restart, and there's no other version to go back to. Check: journalctl -u amahi-kai -n 100"
    fi
    error "$step failed. The code didn't change, so there's nothing to roll back to; Amahi-kai is still running the version it was."
  fi
  log "⚠ $step failed. Going back to ${PREV:0:7}..."
  root_git -C "$APP_DIR" reset --hard --quiet "$PREV" 2>&1 || error "Rollback failed: git couldn't check out ${PREV:0:7}. Run: sudo $APP_DIR/bin/amahi-update"
  "$APP_DIR/bin/amahi-set-ownership" >/dev/null 2>&1 || true
  as_app "bundle install --quiet" 2>&1 || log "⚠ bundle install failed during rollback"
  if [[ -d "$APP_DIR/tmp/assets-previous" ]]; then
    as_app "find public/assets -mindepth 1 -delete && cp -a tmp/assets-previous/. public/assets/" 2>&1 \
      || log "⚠ Couldn't restore the compiled assets"
  fi
  "$APP_DIR/bin/amahi-install-helper" >/dev/null 2>&1 || log "⚠ Couldn't reinstall the previous helper and sudoers rules"
  if [[ -n "$restarted" ]]; then
    log "Restarting the previous version..."
    if ! restart_app; then
      error "Update failed at: $step. Rolled back to ${PREV:0:7}, but it didn't start either. Check: journalctl -u amahi-kai -n 100"
    fi
  fi
  error "Update failed at: $step. Rolled back to ${PREV:0:7}; Amahi-kai is running the version it was.${BACKUP_FILE:+ Database backup: $BACKUP_FILE}"
}

# Updates the status the web UI shows (Update available / Up to date). The helper's check
# takes the update lock, so it's released first; the check never fails the update.
refresh_update_status() {
  exec 9>&-
  /usr/local/sbin/amahi-helper system.check_update </dev/null >/dev/null 2>&1 || true
}

# A dump of the app's database, readable by root only; the newest 3 are kept.
backup_database() {
  local name="${DATABASE_NAME:-amahi_production}"
  install -d -o root -g root -m 0700 "$BACKUP_DIR"
  BACKUP_FILE="$BACKUP_DIR/$name-$(date +%Y%m%d-%H%M%S)-${PREV:0:7}.sql.gz"
  (
    umask 077
    mysqldump --single-transaction --quick --routines --events "$name" | gzip > "$BACKUP_FILE.part"
  ) && mv "$BACKUP_FILE.part" "$BACKUP_FILE" || { rm -f "$BACKUP_FILE.part"; BACKUP_FILE=""; return 1; }
  ls -1t "$BACKUP_DIR/$name"-*.sql.gz 2>/dev/null | tail -n +4 | xargs -r rm -f --
}

# Must be root
if [[ $EUID -ne 0 ]]; then
  error "This script must be run as root (or with sudo)."
fi

# Check app directory exists
[[ -d "$APP_DIR" ]] || error "App directory not found: $APP_DIR"

cd "$APP_DIR"

# One update at a time (the web UI's job, or one started from a terminal). The check for
# updates takes the same lock for its fetch (a minute at most), so wait that long for it.
exec 9>/run/amahi-kai-update.lock
flock -w 90 9 || error "Another update is already running."

# Repair from the web UI: the root helper left a flag. It's read once; a re-exec below
# passes --repair on.
if [[ -f "$REPAIR_FLAG" ]]; then
  rm -f "$REPAIR_FLAG"
  REPAIR=true
  ORIG_ARGS+=(--repair)
fi

# Source env if available
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# 1. Root owns the code, then pulls the latest. (Older versions left the checkout to the
#    app user; the first update with this step takes it back.)
log "Setting file ownership..."
"$APP_DIR/bin/amahi-set-ownership" 2>&1 || error "Couldn't set file ownership"

# The commit to go back to: the one running now. After the re-exec below, the copy of this
# script that pulled passes it on; an older copy didn't, so it's the commit before the pull.
if [[ -n "${AMAHI_UPDATE_PREV:-}" ]]; then
  PREV="$AMAHI_UPDATE_PREV"
elif [[ -n "${AMAHI_UPDATE_REEXEC:-}" ]]; then
  PREV=$(root_git -C "$APP_DIR" rev-parse --verify --quiet 'HEAD@{1}' 2>/dev/null || true)
else
  PREV=$(root_git -C "$APP_DIR" rev-parse --verify --quiet HEAD 2>/dev/null || true)
fi
BACKUP_FILE=""

log "Pulling latest code..."
SCRIPT_SUM_BEFORE=$(sha256sum < "$APP_DIR/bin/amahi-update")
REPO_URL="https://github.com/CatDogBark/Amahi-kai.git"

PULL_FAILED=false
if [[ -d ".git" ]]; then
  root_git -C "$APP_DIR" pull origin main 2>&1 || PULL_FAILED=true
else
  # No .git — clone to temp and sync files over
  log "No git history found — cloning fresh..."
  CLONE_DIR=$(mktemp -d)
  if root_git clone "$REPO_URL" "$CLONE_DIR/repo" 2>&1; then
    rsync -a --exclude='.git' --exclude='vendor/bundle' --exclude='tmp' --exclude='log' --exclude='public/assets' \
      "$CLONE_DIR/repo/" "$APP_DIR/"
    # Preserve .git for future pulls
    cp -r "$CLONE_DIR/repo/.git" "$APP_DIR/.git"
    log "Code synced from repository"
  else
    log "⚠ Git clone failed — using files on disk"
  fi
  rm -rf "$CLONE_DIR"
fi

# bash keeps running the copy of this script it opened, so after the pull a step added
# by this update wouldn't run until the next update. Carry on with the new copy instead.
if [[ -z "${AMAHI_UPDATE_REEXEC:-}" && "$(sha256sum < "$APP_DIR/bin/amahi-update")" != "$SCRIPT_SUM_BEFORE" ]]; then
  log "Update script changed; continuing with the new version..."
  exec 9>&-
  exec env AMAHI_UPDATE_REEXEC=1 AMAHI_UPDATE_PREV="$PREV" "$APP_DIR/bin/amahi-update" "${ORIG_ARGS[@]}"
fi

NEW=$(root_git -C "$APP_DIR" rev-parse HEAD 2>/dev/null || true)
if $REPAIR; then
  $PULL_FAILED && log "⚠ Git pull failed; repairing the version on disk"
  log "Repairing ${NEW:0:7}: running every step again..."
elif $PULL_FAILED; then
  error "Couldn't get the latest code from GitHub (the git output is above). Nothing changed; Amahi-kai is still running ${PREV:0:7}."
elif [[ -n "$PREV" && -n "$NEW" && "$NEW" == "$PREV" ]]; then
  refresh_update_status
  log "✓ Already up to date (${NEW:0:7}). Nothing to install."
  exit 0
fi
if [[ -n "$PREV" && -n "$NEW" && "$NEW" != "$PREV" ]]; then
  log "Updating from ${PREV:0:7} to ${NEW:0:7}"
fi

# The pull may have added files; they're root's already, but a new app folder isn't.
"$APP_DIR/bin/amahi-set-ownership" >/dev/null 2>&1 || rollback "Setting file ownership"

# Keep the running version's compiled assets, for a rollback.
as_app "rm -rf tmp/assets-previous && cp -a public/assets tmp/assets-previous" 2>&1 || log "⚠ Couldn't keep a copy of the compiled assets"

# 2. Install dependencies (into vendor/bundle; settings in .bundle/config)
log "Installing dependencies..."
as_app "bundle install --quiet" 2>&1 || rollback "Installing dependencies"

# 3. Back up the database, then run migrations
log "Backing up the database..."
if backup_database 2>&1; then
  log "  $BACKUP_FILE"
else
  rollback "Backing up the database"
fi
log "Running database migrations..."
as_app "RAILS_ENV=production bin/rails db:migrate" 2>&1 || rollback "Running database migrations"

# Apps announce themselves on the LAN through Avahi (the helper's apps.announce, which the
# helper step below runs): installed on new NASes, added here for the ones from before. Not
# having it only means apps aren't announced, so it never fails the update.
if ! dpkg-query -W -f='${Status}' avahi-daemon 2>/dev/null | grep -q 'install ok installed'; then
  log "Installing avahi-daemon, so apps can be found on the network..."
  { apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends avahi-daemon; } >/dev/null 2>&1 \
    || log "⚠ Couldn't install avahi-daemon; apps won't be announced on the network"
fi

# 3a. Install the root helper and the sudoers rules. Samba, user account and share folder
#     changes go through the helper (3b and 3c use it), and the updater is the only thing
#     that installs sudoers changes on an existing NAS. The sudoers file is replaced only
#     if visudo accepts the new one.
log "Installing the privileged helper and sudoers rules..."
"$APP_DIR/bin/amahi-install-helper" 2>&1 || log "⚠ Privileged helper not fully installed; user, Samba and share changes may fail"

# 3b. Regenerate smb.conf from the app's settings so changes to the generated config
#     (network binding, Greyhole settings) take effect on update, then restart Samba:
#     a new binding only applies after a restart. An invalid config is never installed.
log "Updating Samba configuration..."
if as_app "RAILS_ENV=production bin/rails runner 'exit(SambaService.push_config ? 0 : 1)'" 2>&1; then
  systemctl restart smbd nmbd 2>&1 || log "⚠ Samba restart failed"
else
  log "⚠ Samba config not regenerated; keeping the current one"
fi

# 3c. Web users' Linux accounts get no login shell and no extra groups (older versions
#     gave them /bin/sh, and admins the sudo group). Accounts the app didn't create are
#     left alone.
log "Checking user accounts..."
as_app "RAILS_ENV=production bin/rails runner 'User.normalize_system_accounts'" 2>&1 || log "⚠ User accounts not checked"

# 3d. The app writes uploads into share folders that Samba users own (group users)
id -nG "$APP_USER" | grep -qw users || usermod -aG users "$APP_USER"

# 3e. Keep secrets root-only. cloudflared reads the tunnel token from TOKEN_FILE
#     (--token-file); older installs had it in the world-readable unit file and on
#     cloudflared's command line. Switch only when the file holds the same token the
#     unit uses, so a tunnel set up by hand is left alone. Nothing is printed.
TOKEN_FILE=/etc/amahi-kai/tunnel.token
UNIT_FILE=/etc/systemd/system/cloudflared.service
if [[ -f "$TOKEN_FILE" ]]; then
  chown root:root "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  if [[ -f "$UNIT_FILE" ]] && grep -q -- 'run --token ' "$UNIT_FILE"; then
    unit_token=$(grep -oP -- 'run --token \K\S+' "$UNIT_FILE" || true)
    if [[ -n "$unit_token" && "$unit_token" == "$(cat "$TOKEN_FILE")" ]]; then
      log "Moving the Cloudflare Tunnel token out of the service file..."
      sed -i -E "s#run --token [^[:space:]]+#run --token-file $TOKEN_FILE#" "$UNIT_FILE"
      systemctl daemon-reload
      systemctl restart cloudflared 2>&1 || log "⚠ cloudflared restart failed"
    fi
    unset unit_token
  fi
fi
# Greyhole's config holds the app's database password; the app user reads it for status.
if [[ -f /etc/greyhole.conf ]]; then
  chown root:"$APP_GROUP" /etc/greyhole.conf
  chmod 640 /etc/greyhole.conf
fi

# 4. Clear cache and precompile assets (in the app user's own folders)
log "Clearing caches..."
as_app "rm -rf tmp/cache/* public/assets/*" 2>&1
log "Precompiling assets..."
# (Without the line Sprockets writes per file, hundreds of them.)
as_app "set -o pipefail; RAILS_ENV=production bin/rails assets:precompile 2>&1 | sed -u '/ INFO -- : Writing /d'" 2>&1 \
  || rollback "Precompiling assets"

# 5. Ensure all fstab mounts are active (FUSE mounts like ntfs-3g can get lost)
log "Restoring mounts..."
mount -a 2>&1 || log "⚠ Some mounts may have failed — check 'mount -a' manually"
# Data drives and the share root mounted nosuid,nodev (fstab lines from before get the options)
reply=$(/usr/local/sbin/amahi-helper disks.secure_mounts </dev/null 2>/dev/null) \
  || log "⚠ Couldn't set nosuid,nodev on the data drives and share root: $reply"

# 6. Restart the app and check that it answers. Inside amahi-kai.service the restart ends
#    this script, so it's the last thing it does there.
log "Restarting Amahi-kai..."
if in_app_service; then
  systemctl restart amahi-kai 2>&1 || error "Failed to restart service"
  exit 0
fi
restart_app || rollback "Starting the new version" restarted
refresh_update_status
log "✓ Amahi-kai updated and running!"
