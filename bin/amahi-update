#!/usr/bin/env bash
set -euo pipefail

# Amahi-kai Update Script
# Pulls latest code, installs dependencies, runs migrations, and restarts.
# Usage: sudo /opt/amahi-kai/bin/amahi-update [--stream]
#
# --stream: Output progress messages for SSE streaming (used by web UI)
#
# Root owns the code (bin/amahi-set-ownership) and runs only git, this script, the helper
# installer and system commands. Everything that loads the app or its gems (bundle,
# migrations, rails runner, the asset build) runs as the app user (as_app), which can
# write vendor/bundle, so root never runs code the app user could have changed.

APP_DIR="${APP_DIR:-/opt/amahi-kai}"
ENV_FILE="${ENV_FILE:-/etc/amahi-kai/amahi.env}"
APP_USER="${APP_USER:-amahi}"
APP_GROUP="${APP_GROUP:-amahi}"
STREAM=false
ORIG_ARGS=("$@")

if [[ "${1:-}" == "--stream" ]]; then
  STREAM=true
fi

log() {
  if $STREAM; then
    echo "$1"
  else
    echo "==> $1"
  fi
}

error() {
  if $STREAM; then
    echo "✗ $1" >&2
  else
    echo "ERROR: $1" >&2
  fi
  exit 1
}

# Runs a command in the app folder as the app user, with the app's environment.
as_app() {
  sudo -u "$APP_USER" -H bash -lc "set -a && source '$ENV_FILE' && set +a && cd '$APP_DIR' && $1"
}

# Git as root, without hooks or an fsmonitor command from the checkout's own config.
root_git() {
  git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# Must be root
if [[ $EUID -ne 0 ]]; then
  error "This script must be run as root (or with sudo)."
fi

# Check app directory exists
[[ -d "$APP_DIR" ]] || error "App directory not found: $APP_DIR"

cd "$APP_DIR"

# Source env if available
if [[ -f "$ENV_FILE" ]]; then
  set -a
  source "$ENV_FILE"
  set +a
fi

# 1. Root owns the code, then pulls the latest. (Older versions left the checkout to the
#    app user; the first update with this step takes it back.)
log "Setting file ownership..."
"$APP_DIR/bin/amahi-set-ownership" 2>&1 || error "Couldn't set file ownership"

log "Pulling latest code..."
SCRIPT_SUM_BEFORE=$(sha256sum < "$APP_DIR/bin/amahi-update")
REPO_URL="https://github.com/CatDogBark/Amahi-kai.git"

if [[ -d ".git" ]]; then
  root_git -C "$APP_DIR" pull origin main 2>&1 || log "⚠ Git pull failed — using files on disk"
else
  # No .git — clone to temp and sync files over
  log "No git history found — cloning fresh..."
  CLONE_DIR=$(mktemp -d)
  if root_git clone "$REPO_URL" "$CLONE_DIR/repo" 2>&1; then
    rsync -a --exclude='.git' --exclude='vendor/bundle' --exclude='tmp' --exclude='log' --exclude='public/assets' \
      "$CLONE_DIR/repo/" "$APP_DIR/"
    # Preserve .git for future pulls
    cp -r "$CLONE_DIR/repo/.git" "$APP_DIR/.git"
    log "Code synced from repository"
  else
    log "⚠ Git clone failed — using files on disk"
  fi
  rm -rf "$CLONE_DIR"
fi

# bash keeps running the copy of this script it opened, so after the pull a step added
# by this update wouldn't run until the next update. Carry on with the new copy instead.
if [[ -z "${AMAHI_UPDATE_REEXEC:-}" && "$(sha256sum < "$APP_DIR/bin/amahi-update")" != "$SCRIPT_SUM_BEFORE" ]]; then
  log "Update script changed; continuing with the new version..."
  exec env AMAHI_UPDATE_REEXEC=1 "$APP_DIR/bin/amahi-update" "${ORIG_ARGS[@]}"
fi

# The pull may have added files; they're root's already, but a new app folder isn't.
"$APP_DIR/bin/amahi-set-ownership" >/dev/null 2>&1 || error "Couldn't set file ownership"

# 2. Install dependencies (into vendor/bundle; settings in .bundle/config)
log "Installing dependencies..."
as_app "bundle install" 2>&1

# 3. Run migrations
log "Running database migrations..."
as_app "RAILS_ENV=production bin/rails db:migrate" 2>&1

# 3a. Install the root helper and the sudoers rules. Samba, user account and share folder
#     changes go through the helper (3b and 3c use it), and the updater is the only thing
#     that installs sudoers changes on an existing NAS. The sudoers file is replaced only
#     if visudo accepts the new one.
log "Installing the privileged helper and sudoers rules..."
"$APP_DIR/bin/amahi-install-helper" 2>&1 || log "⚠ Privileged helper not fully installed; user, Samba and share changes may fail"

# 3b. Regenerate smb.conf from the app's settings so changes to the generated config
#     (network binding, Greyhole settings) take effect on update, then restart Samba:
#     a new binding only applies after a restart. An invalid config is never installed.
log "Updating Samba configuration..."
if as_app "RAILS_ENV=production bin/rails runner 'exit(SambaService.push_config ? 0 : 1)'" 2>&1; then
  systemctl restart smbd nmbd 2>&1 || log "⚠ Samba restart failed"
else
  log "⚠ Samba config not regenerated; keeping the current one"
fi

# 3c. Web users' Linux accounts get no login shell and no extra groups (older versions
#     gave them /bin/sh, and admins the sudo group). Accounts the app didn't create are
#     left alone.
log "Checking user accounts..."
as_app "RAILS_ENV=production bin/rails runner 'User.normalize_system_accounts'" 2>&1 || log "⚠ User accounts not checked"

# 3d. The app writes uploads into share folders that Samba users own (group users)
id -nG "$APP_USER" | grep -qw users || usermod -aG users "$APP_USER"

# 3e. Keep secrets root-only. cloudflared reads the tunnel token from TOKEN_FILE
#     (--token-file); older installs had it in the world-readable unit file and on
#     cloudflared's command line. Switch only when the file holds the same token the
#     unit uses, so a tunnel set up by hand is left alone. Nothing is printed.
TOKEN_FILE=/etc/amahi-kai/tunnel.token
UNIT_FILE=/etc/systemd/system/cloudflared.service
if [[ -f "$TOKEN_FILE" ]]; then
  chown root:root "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  if [[ -f "$UNIT_FILE" ]] && grep -q -- 'run --token ' "$UNIT_FILE"; then
    unit_token=$(grep -oP -- 'run --token \K\S+' "$UNIT_FILE" || true)
    if [[ -n "$unit_token" && "$unit_token" == "$(cat "$TOKEN_FILE")" ]]; then
      log "Moving the Cloudflare Tunnel token out of the service file..."
      sed -i -E "s#run --token [^[:space:]]+#run --token-file $TOKEN_FILE#" "$UNIT_FILE"
      systemctl daemon-reload
      systemctl restart cloudflared 2>&1 || log "⚠ cloudflared restart failed"
    fi
    unset unit_token
  fi
fi
# Greyhole's config holds the app's database password; the app user reads it for status.
if [[ -f /etc/greyhole.conf ]]; then
  chown root:"$APP_GROUP" /etc/greyhole.conf
  chmod 640 /etc/greyhole.conf
fi

# 4. Clear cache and precompile assets (in the app user's own folders)
log "Clearing caches..."
as_app "rm -rf tmp/cache/* public/assets/*" 2>&1
log "Precompiling assets..."
as_app "RAILS_ENV=production bin/rails assets:precompile" 2>&1

# 5. Ensure all fstab mounts are active (FUSE mounts like ntfs-3g can get lost)
log "Restoring mounts..."
mount -a 2>&1 || log "⚠ Some mounts may have failed — check 'mount -a' manually"

# 6. Restart service. This is last on purpose: run from the web UI, this script is part
#    of the amahi-kai service, so restarting the service ends the script as well.
log "Restarting Amahi-kai..."
systemctl restart amahi-kai 2>&1 || error "Failed to restart service"

# Verify it's running (reached when run from a terminal)
sleep 2
if systemctl is-active --quiet amahi-kai; then
  log "✓ Amahi-kai updated and running!"
else
  error "Service failed to start after update. Check: journalctl -u amahi-kai -f"
fi
