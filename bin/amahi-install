#!/bin/bash
# bin/amahi-install — Amahi-kai native production installer for Ubuntu 24.04
# Run it once on a blank server. Running it again keeps users, shares, settings and the version
# installed: it brings the gems, database and services in line with that code and restarts the
# app. New versions come through System Update, which follows the update channel.
set -euo pipefail

APP_DIR="/opt/amahi-kai"
CONFIG_DIR="/etc/amahi-kai"
ENV_FILE="$CONFIG_DIR/amahi.env"
SHARE_ROOT="/var/lib/amahi-kai/files"
REPO_URL="https://github.com/CatDogBark/Amahi-kai.git"
APP_USER="amahi"
APP_GROUP="amahi"
# apt never stops to ask (a changed config file, services to restart).
export DEBIAN_FRONTEND=noninteractive

# Parse flags
HEADLESS=false
for arg in "$@"; do
  case "$arg" in
    --headless)     HEADLESS=true ;;
    --with-greyhole)
      echo "--with-greyhole is gone: the setup wizard installs Greyhole, or Disks → Greyhole Pool later." >&2
      exit 1
      ;;
    --help|-h)
      echo "Usage: sudo bin/amahi-install [OPTIONS]"
      echo ""
      echo "Options:"
      echo "  --headless        Skip the setup wizard (the admin keeps the random first password printed at the end)"
      echo "  --help            Show this help"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

echo "============================================"
echo "  Amahi-kai Production Installer"
echo "  Target: Ubuntu 24.04"
if $HEADLESS; then
  echo "  Mode: HEADLESS"
fi
echo "============================================"
echo ""

# Must run as root
if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: This script must be run as root (or with sudo)." >&2
  exit 1
fi

# Amahi-kai is made for Ubuntu 24.04: its Ruby (3.2), and the Docker and Tailscale
# repositories the helper adds, are Ubuntu 24.04's.
OS_NAME=$(. /etc/os-release 2>/dev/null && echo "${ID:-}-${VERSION_ID:-}" || true)
if [[ "$OS_NAME" != "ubuntu-24.04" ]]; then
  echo "⚠ This isn't Ubuntu 24.04 ($(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-unknown}")). Amahi-kai is made for it; elsewhere it may not install or work."
  echo ""
fi

# Root owns the code (bin/amahi-set-ownership) and runs only system commands. Everything
# that loads the app or its gems (bundle, migrations, seeds, rails runner, the asset
# build) runs as the app user, with the app's environment.
as_app() {
  sudo -u "$APP_USER" -H bash -lc "set -a && source '$ENV_FILE' && set +a && cd '$APP_DIR' && $1"
}

# Whether the app answers on its port, waiting up to 90 seconds (as bin/amahi-update does).
app_answers() {
  local i
  for i in $(seq 1 45); do
    if curl -fsS -o /dev/null --max-time 5 "http://127.0.0.1:3000/login" 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# ---------------------------------------------------------------------------
# 1. Ensure swap exists (critical for low-RAM systems)
# ---------------------------------------------------------------------------
if ! swapon --show | grep -q '/'; then
  TOTAL_RAM_MB=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo)
  if [ "$TOTAL_RAM_MB" -lt 8192 ]; then
    SWAP_SIZE="2G"
    [ "$TOTAL_RAM_MB" -lt 2048 ] && SWAP_SIZE="4G"
    echo "==> No swap detected (${TOTAL_RAM_MB}MB RAM) — creating ${SWAP_SIZE} swapfile..."
    fallocate -l "$SWAP_SIZE" /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count="${SWAP_SIZE%G}000" status=progress
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    if ! grep -q '/swapfile' /etc/fstab; then
      echo '/swapfile none swap sw 0 0' >> /etc/fstab
    fi
    echo "==> Swap enabled: ${SWAP_SIZE}"
  fi
else
  echo "==> Swap already active: $(swapon --show --noheadings | awk '{print $3}')"
fi

# ---------------------------------------------------------------------------
# 2. System packages, Ruby among them
# ---------------------------------------------------------------------------
echo "==> Installing system dependencies..."
apt-get update
apt-get install -y --no-install-recommends \
  acl \
  build-essential \
  curl \
  git \
  gnupg \
  libffi-dev \
  libmariadb-dev \
  libssl-dev \
  libyaml-dev \
  zlib1g-dev \
  mariadb-server \
  ruby \
  ruby-dev \
  ruby-bundler \
  samba \
  avahi-daemon \
  samba-common-bin \
  samba-vfs-modules \
  ntfs-3g \
  smartmontools \
  sudo

# Ruby 3.2, Ubuntu 24.04's own: the app's service files (config/systemd) run /usr/bin/bundle.
# Ubuntu's bundler (2.4.x) runs Gemfile.lock as it is; no newer one is installed.
RUBY_FOUND=$(ruby -e 'puts RUBY_VERSION' 2>/dev/null || true)
if [[ "$RUBY_FOUND" != 3.2.* ]]; then
  echo "  ❌ Amahi-kai needs Ruby 3.2, Ubuntu 24.04's, and this system has ${RUBY_FOUND:-none}." >&2
  exit 1
fi
echo "==> Ruby $RUBY_FOUND"

# VM guest agent (auto-detect)
if systemd-detect-virt -q 2>/dev/null; then
  VIRT_TYPE=$(systemd-detect-virt 2>/dev/null || true)
  echo "==> Virtual machine detected ($VIRT_TYPE), installing guest agent..."
  case "$VIRT_TYPE" in
    kvm|qemu)
      apt-get install -y --no-install-recommends qemu-guest-agent
      # The agent starts by itself whenever the VM has its port (Proxmox: Options → QEMU Guest
      # Agent, then a full stop and start). Without it, starting the agent would only wait 90
      # seconds for the port and fail.
      if [ -e /dev/virtio-ports/org.qemu.guest_agent.0 ]; then
        systemctl start qemu-guest-agent 2>/dev/null || true
      else
        echo "  The guest agent starts once the VM has its port: in Proxmox, turn on Options → QEMU Guest Agent,"
        echo "  then stop and start the VM."
      fi
      ;;
    vmware)
      apt-get install -y --no-install-recommends open-vm-tools
      systemctl enable --now vmtoolsd 2>/dev/null || true
      ;;
    *)
      echo "  (no specific guest agent for $VIRT_TYPE)"
      ;;
  esac
fi

# Disable memory-hungry services not needed on a NAS (~70MB savings)
for svc in fwupd.service multipathd.service; do
  if systemctl is-active --quiet "$svc" 2>/dev/null; then
    echo "==> Disabling $svc (not needed, saves memory)..."
    systemctl stop "$svc" 2>/dev/null || true
    systemctl disable "$svc" 2>/dev/null || true
    systemctl mask "$svc" 2>/dev/null || true
  fi
done

# ---------------------------------------------------------------------------
# 3. Create system user
# ---------------------------------------------------------------------------
if ! id "$APP_USER" &>/dev/null; then
  echo "==> Creating system user '$APP_USER'..."
  useradd --system --create-home --shell /bin/bash --user-group "$APP_USER"
else
  # The web app runs as this account and gets everything it has. An account someone signs in
  # with (the owner's own, named at Ubuntu's install, or a cloud image's) would hand the web
  # app its sudo rights, groups, files and keys, so only a system account like the one this
  # installer makes is used: a number below 1000, no password, no groups beyond its own, users
  # and docker (which an older version added and amahi-install-helper takes away), and no sudo
  # rule but the helper's.
  app_uid=$(id -u "$APP_USER")
  app_groups=$(id -nG "$APP_USER" | tr ' ' '\n' | grep -vx -e "$APP_GROUP" -e users -e docker | tr '\n' ' ' || true)
  app_password=$(getent shadow "$APP_USER" | cut -d: -f2 || true)
  app_rules=$(sudo -n -l -U "$APP_USER" 2>/dev/null | sed -n '/may run the following/,$p' | tail -n +2 | grep -v 'amahi-helper' | grep -c '[^[:space:]]' || true)
  problems=()
  (( app_uid < 1000 )) || problems+=("its number is $app_uid, an account people sign in with")
  [[ -z "${app_groups// /}" ]] || problems+=("it's in other groups: $app_groups")
  [[ "$app_password" == '!'* || "$app_password" == '*'* ]] || problems+=("it has a password")
  (( ${app_rules:-0} == 0 )) || problems+=("sudo lets it run other commands")
  if (( ${#problems[@]} > 0 )); then
    echo "ERROR: An account named '$APP_USER' already exists, and it isn't a system account Amahi-kai can use:" >&2
    printf '  - %s\n' "${problems[@]}" >&2
    echo "  Amahi-kai runs its web app as '$APP_USER', which would get everything that account has." >&2
    echo "  Rename that account or remove it, then run the installer again." >&2
    exit 1
  fi
  echo "==> User '$APP_USER' already exists, a system account: using it"
fi
# The app writes uploads into share folders that Samba users own (group users)
usermod -aG users "$APP_USER"

# ---------------------------------------------------------------------------
# 4. Deploy application code, with its git history (System Update and the check for updates
#    use it)
# ---------------------------------------------------------------------------
echo "==> Deploying application to $APP_DIR..."
mkdir -p "$APP_DIR"

if [[ "${AMAHI_CODE_FETCHED:-}" == 1 && -d "$APP_DIR/.git" ]]; then
  echo "    Using the code install.sh just fetched"
elif [ -d "$APP_DIR/.git" ]; then
  # A re-run keeps the version installed: System Update brings new ones, from the update channel.
  echo "    Existing installation found: keeping the version installed (System Update brings new ones)"
elif [ -f "$APP_DIR/Gemfile" ]; then
  echo "    Existing installation found (no git), using current code..."
else
  # Run from a checkout: a clone of it (its committed code), which then follows GitHub.
  SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
  if [ -d "$SCRIPT_DIR/.git" ]; then
    echo "    Cloning the local checkout..."
    git -c safe.directory="$SCRIPT_DIR" -c core.hooksPath=/dev/null clone --quiet --no-hardlinks "$SCRIPT_DIR" "$APP_DIR"
    git -C "$APP_DIR" remote set-url origin "$REPO_URL"
  else
    echo "    Cloning from GitHub..."
    git clone "$REPO_URL" "$APP_DIR"
  fi
fi

# The code is root's; tmp/, log/, public/assets/ and vendor/bundle/ are the app user's.
cd "$APP_DIR"
"$APP_DIR/bin/amahi-set-ownership"

# ---------------------------------------------------------------------------
# 5. Create directories + config (must happen before bundle/DB steps)
# ---------------------------------------------------------------------------
echo "==> Creating data directories..."
mkdir -p "$SHARE_ROOT"
# Root's: the share folders in it are made by the root helper (shares.create_dir), the app's
# user owning each; owning the root itself, that user could put a link there in place of one.
chown root:root "$SHARE_ROOT"
chmod 0755 "$SHARE_ROOT"
mkdir -p "$CONFIG_DIR"
mkdir -p /var/lib/amahi-kai/tmp
chown "$APP_USER:$APP_GROUP" /var/lib/amahi-kai/tmp

if [ ! -f "$ENV_FILE" ]; then
  echo "==> Generating configuration..."
  # A development install (AMAHI_BRANCH=dev through install.sh) keeps following the dev branch.
  UPDATE_CHANNEL=releases
  [[ "${AMAHI_BRANCH:-main}" == dev ]] && UPDATE_CHANNEL=development
  SECRET=$(openssl rand -hex 32)
  DB_PASS=$(openssl rand -hex 16)
  # Root's alone from the start; the app's group can read it once the secrets are in.
  install -o root -g root -m 0600 /dev/null "$ENV_FILE"
  cat > "$ENV_FILE" <<EOF
# Amahi-kai production configuration
# Generated by bin/amahi-install on $(date -Iseconds)

SECRET_KEY_BASE=$SECRET
RAILS_ENV=production

# Serve static assets from Puma (no nginx reverse proxy in front)
RAILS_SERVE_STATIC_FILES=true

DATABASE_HOST=localhost
DATABASE_NAME=amahi_production
DATABASE_USER=amahi
DATABASE_PASSWORD=$DB_PASS

# Extra host names the web UI answers to (comma-separated). Not needed for IP
# addresses, localhost, this machine's hostname, its Tailscale name or a
# Cloudflare Tunnel; add other DNS names that point at this server.
# RAILS_ALLOWED_HOSTS=nas.example.lan

# Where System Update gets new versions: releases (published releases), candidates
# (releases and release candidates) or development (the dev branch, for testing).
AMAHI_UPDATE_CHANNEL=$UPDATE_CHANNEL
EOF
  chmod 640 "$ENV_FILE"
  chown root:"$APP_USER" "$ENV_FILE"
  echo "    Config written to $ENV_FILE"
else
  echo "    Config already exists at $ENV_FILE (skipping)"
  chmod 640 "$ENV_FILE"
  chown root:"$APP_USER" "$ENV_FILE"
fi

# Source the env file for DB setup
set -a
source "$ENV_FILE"
set +a

# ---------------------------------------------------------------------------
# 6. MariaDB setup
# ---------------------------------------------------------------------------
echo "==> Configuring MariaDB..."
systemctl enable --now mariadb

# Create database and user (idempotent)
mysql -u root <<EOSQL || true
CREATE DATABASE IF NOT EXISTS \`${DATABASE_NAME:-amahi_production}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS '${DATABASE_USER:-amahi}'@'localhost' IDENTIFIED BY '${DATABASE_PASSWORD:-amahi}';
ALTER USER '${DATABASE_USER:-amahi}'@'localhost' IDENTIFIED BY '${DATABASE_PASSWORD:-amahi}';
GRANT ALL PRIVILEGES ON \`${DATABASE_NAME:-amahi_production}\`.* TO '${DATABASE_USER:-amahi}'@'localhost';
FLUSH PRIVILEGES;
EOSQL

# ---------------------------------------------------------------------------
# 7. Bundle install
# ---------------------------------------------------------------------------
echo "==> Installing Ruby gems..."
if ! as_app "bundle install"; then
  echo ""
  echo "  ❌ Bundle install failed! Check for missing system libraries."
  echo "  Try running manually:"
  echo "    sudo -u $APP_USER bash -lc 'cd $APP_DIR && bundle install'"
  echo ""
  exit 1
fi

# ---------------------------------------------------------------------------
# 8. Privileged helper, sudoers rules and the app's service files (before db:seed: creating
#    the admin user makes its Linux and Samba accounts through the helper)
# ---------------------------------------------------------------------------
echo "==> Installing the privileged helper, sudoers rules and services..."
if ! "$APP_DIR/bin/amahi-install-helper"; then
  echo ""
  echo "  ❌ The privileged helper or sudoers rules couldn't be installed."
  echo "  Try running manually:"
  echo "    sudo $APP_DIR/bin/amahi-install-helper"
  echo ""
  exit 1
fi

# Data drives and the share root mount nosuid,nodev; the share root is bound onto itself for it.
/usr/local/sbin/amahi-helper disks.secure_mounts </dev/null >/dev/null 2>&1 \
  || echo "  ⚠ Couldn't set nosuid,nodev on the share root (System Update tries again)"

# smartd starts in a virtual machine too (Ubuntu's unit skips it in one), for drives passed through.
/usr/local/sbin/amahi-helper smart.setup </dev/null >/dev/null 2>&1 \
  || echo "  ⚠ Couldn't set up SMART monitoring (System Update tries again)"

# ---------------------------------------------------------------------------
# 9. Database migrations and the first admin
# ---------------------------------------------------------------------------
echo "==> Running database migrations..."
if ! as_app "RAILS_ENV=production bin/rails db:migrate"; then
  echo ""
  echo "  ❌ Database migration failed!"
  echo "  Try running manually:"
  echo "    sudo -u $APP_USER bash -lc 'set -a; source $ENV_FILE; set +a; cd $APP_DIR && RAILS_ENV=production bin/rails db:migrate'"
  echo ""
  exit 1
fi

# The admin's first password is random. The seeds read it from a file only the app user can
# read (never a command line, where ps would show it) and delete it once used; seeding is
# skipped when the database has users, and then the file is left and nothing is printed.
echo "==> Seeding database (skipped when it already has users)..."
ADMIN_PASS=$(openssl rand -base64 24 | tr -d '/+=\n')
ADMIN_PASS=${ADMIN_PASS:0:20}
PW_DIR=$(mktemp -d /run/amahi-first-password.XXXXXX)
trap 'rm -rf "$PW_DIR"' EXIT
PW_FILE="$PW_DIR/password"
# Written while the folder is still root's, then handed over: once the app user owns the
# folder it could put a link where root writes.
( umask 077; printf '%s' "$ADMIN_PASS" > "$PW_FILE" )
chown "$APP_USER:$APP_GROUP" "$PW_FILE" "$PW_DIR"
chmod 0700 "$PW_DIR"
if ! as_app "AMAHI_FIRST_PASSWORD_FILE='$PW_FILE' RAILS_ENV=production bin/rails db:seed"; then
  echo ""
  echo "  ❌ Database seeding failed!"
  echo "  Run the installer again once the error above is fixed."
  echo ""
  exit 1
fi
# A new database: the steps below that set things up for the first time run only then, so
# running the installer again keeps what was changed since.
FRESH=false
if [[ -e "$PW_FILE" ]]; then
  ADMIN_PASS=""   # seeding was skipped: the existing accounts keep their passwords
else
  FRESH=true
fi
rm -rf "$PW_DIR"

show_password() {
  echo "  Sign in as:  admin"
  echo "  Password:    $ADMIN_PASS"
  echo "  (Shown only by this install. Lost it? sudo $APP_DIR/script/reset-user-password admin)"
}

# Shown now as well as at the end, so it isn't lost if a later step fails.
if $FRESH; then
  echo ""
  echo "  ── The first admin account ──────────────────"
  show_password
  echo ""

  # This machine's address, in place of the seeds' defaults (Samba's LAN binding uses it).
  HOST_IP=$(hostname -I | awk '{print $1}')
  if [ -n "$HOST_IP" ]; then
    NET_PREFIX=$(echo "$HOST_IP" | cut -d. -f1-3)
    SELF_ADDR=$(echo "$HOST_IP" | cut -d. -f4)
    echo "==> Configuring network settings for $HOST_IP..."
    as_app "RAILS_ENV=production bin/rails runner \"
      Setting.set('net', '$NET_PREFIX')
      Setting.set('self-address', '$SELF_ADDR')
    \"" || echo "  ⚠ Couldn't save this server's address ($HOST_IP); Samba answers on all networks until it is"
  fi

  # Nothing updates by itself: Ubuntu's automatic updates stay off until they're switched on
  # (Settings → System Dependencies, where updates are installed). apt still refreshes its
  # package lists daily, which is how the page and the dashboard know what's waiting.
  printf 'APT::Periodic::Update-Package-Lists "1";\nAPT::Periodic::Unattended-Upgrade "0";\n' > /etc/apt/apt.conf.d/20auto-upgrades
fi

# Headless mode: no setup wizard. The admin keeps the random first password printed below
# (so the security audit doesn't ask for it to be changed), and setup is marked complete.
if $HEADLESS; then
  echo "==> Headless mode: marking setup complete..."
  as_app "RAILS_ENV=production bin/rails runner \"Setting.where(name: User::FIRST_PASSWORD_SETTING).delete_all; Setting.set('setup_completed', 'true')\"" \
    || echo "  ⚠ Couldn't mark setup complete: the setup wizard opens at the first sign-in instead"
fi

# ---------------------------------------------------------------------------
# 10. Asset precompilation
# ---------------------------------------------------------------------------
echo "==> Precompiling assets..."
if ! as_app "rm -rf tmp/cache/assets && RAILS_ENV=production bin/rails assets:precompile"; then
  echo ""
  echo "  ❌ Asset precompilation failed!"
  echo "  Try running manually:"
  echo "    sudo -u $APP_USER bash -lc 'cd $APP_DIR && RAILS_ENV=production bin/rails assets:precompile'"
  echo ""
  exit 1
fi

# ---------------------------------------------------------------------------
# 11. Firewall — open port 3000 (Puma direct)
# ---------------------------------------------------------------------------
if command -v ufw &>/dev/null && ufw status | grep -q "Status: active"; then
  echo "==> Opening port 3000 in UFW..."
  ufw allow 3000/tcp comment "Amahi-kai web UI (Puma)" || true
fi

# ---------------------------------------------------------------------------
# 12. Samba: its config comes from the app (Share.samba_conf), as at every System Update, so
#     it answers on the LAN only from the start, without Ubuntu's printer shares.
# ---------------------------------------------------------------------------
echo "==> Writing Samba's configuration..."
# Clean stale WINS database (causes nmbd segfault on fresh installs)
rm -f /var/lib/samba/wins.dat /var/cache/samba/wins.tdb
systemctl enable smbd nmbd
if as_app "RAILS_ENV=production bin/rails runner 'exit(SambaService.push_config ? 0 : 1)'"; then
  systemctl restart smbd nmbd
else
  echo "  ⚠ Samba's configuration wasn't written (System Update tries again); Ubuntu's stays for now"
  systemctl restart smbd nmbd || true
fi
# dnsmasq disabled by default — enable when DNS aliases are configured
# systemctl enable --now dnsmasq

# ---------------------------------------------------------------------------
# 13. File search index (its service and timer come with the helper, step 8)
# ---------------------------------------------------------------------------
echo "==> Building file search index..."
as_app "RAILS_ENV=production bin/rails shares:reindex" || true
systemctl enable --now amahi-kai-indexer.timer

# ---------------------------------------------------------------------------
# 14. Start Amahi-kai (or restart it, running the code installed now) and check it answers
# ---------------------------------------------------------------------------
echo "==> Starting Amahi-kai..."
systemctl restart amahi-kai
if ! app_answers; then
  echo ""
  echo "  ❌ Amahi-kai didn't answer on port 3000 within 90 seconds."
  echo "  Check: journalctl -u amahi-kai -n 100"
  echo ""
  exit 1
fi

# The version installed, written down for System Update: it finishes an update that stopped
# partway instead of calling it up to date.
if installed_commit=$(git -c core.hooksPath=/dev/null -C "$APP_DIR" rev-parse HEAD 2>/dev/null); then
  printf '%s\n' "$installed_commit" > /var/lib/amahi-kai/deployed-commit
fi

echo ""
echo "============================================"
echo "  Amahi-kai installation complete!"
echo "============================================"
echo ""
echo "  Web UI:  http://$(hostname -I | awk '{print $1}'):3000"
echo "  Remote access: Setup → Network → Remote Access (Tailscale, or a Cloudflare Tunnel)"
if $FRESH; then
  echo ""
  show_password
  if $HEADLESS; then
    echo "  Setup wizard: skipped (headless)"
  else
    echo "  The setup wizard asks you to choose a password of your own, then guides"
    echo "  you through the rest of the setup."
  fi
  echo ""
else
  echo "  Sign in with your existing account: this run didn't change any passwords."
  echo ""
fi
echo "  Config:  $ENV_FILE"
echo "  App:     $APP_DIR"
echo "  Shares:  $SHARE_ROOT"
echo "  Logs:    journalctl -u amahi-kai -f"
echo "  Backups: Amahi-kai doesn't back this server up yet; what to keep copies of:"
echo "           https://amahi-kai.com/wiki/getting-started#what-amahi-kai-doesnt-back-up"
echo ""
echo "  Services:"
echo "    systemctl status amahi-kai   # Rails app (Puma on :3000)"
echo "    systemctl status mariadb     # Database"
echo "    systemctl status smbd        # Samba file sharing"
echo ""
