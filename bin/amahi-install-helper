#!/usr/bin/env bash
# bin/amahi-install-helper: installs the root helper and the app's sudoers rules.
# bin/amahi-install and bin/amahi-update run it as root; running it again is safe.
#
#   /usr/local/sbin/amahi-helper    libexec/amahi-helper and its parts as one file, root:root 0755
#   /var/log/amahi-kai/helper.log   the helper's audit log, root:amahi 0640
#   /etc/logrotate.d/amahi-kai      from config/logrotate-amahi-kai.conf
#   /etc/amahi-kai/allowed_signers  the release keys, from config/allowed_signers, root:root 0644
#   /etc/amahi-kai/allow-development   on a server that follows the dev branch (see below)
#   /etc/systemd/system/amahi-kai.service          the web UI (enabled; bin/amahi-install and
#                                                   bin/amahi-update start and restart it)
#   /etc/systemd/system/amahi-kai-indexer.{service,timer}   the file search index, every 10 minutes
#   /etc/systemd/system/amahi-kai-update.service   System Update's job
#   /etc/systemd/system/amahi-kai-update-check.{service,timer}   the check for updates (Amahi-kai and its apps), every 6 hours
#   /etc/systemd/system/amahi-kai-storage-check.{service,timer}  the storage health check, every 15 minutes
#   /etc/systemd/system/amahi-kai-snapshots.{service,timer}      pool snapshots, every hour
#   /etc/systemd/system/amahi-kai-app-firewall.service   app ports kept to the LAN and Tailscale, with Docker
#   /etc/systemd/system/amahi-kai-app-firewall-early.service   the same rules in place before Docker starts
#   /etc/systemd/system/amahi-kai-app-shares.service   the share folders apps are given, mounted before Docker starts
#   /etc/systemd/system/amahi-kai-app-backups.{service,timer}    app update copies deleted after 30 days, daily
#   /etc/systemd/system/amahi-kai-trash.{service,timer}          files kept in the Trash too long deleted, daily
#   /etc/systemd/system/amahi-kai-tailscale.{service,path}       DNS and Samba follow Tailscale's address
#   /etc/sudoers.d/amahi-kai        from config/sudoers/amahi-kai, only if visudo accepts it
#
# It also takes the app's user out of the docker group (Docker runs only through the helper).
#
# Exits non-zero if something wasn't installed; the sudoers file is then left as it was.
set -euo pipefail

APP_DIR="${APP_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
APP_GROUP="${APP_GROUP:-amahi}"
APP_USER="${APP_USER:-amahi}"
SUDOERS=/etc/sudoers.d/amahi-kai

if [[ $EUID -ne 0 ]]; then
  echo "amahi-install-helper: run this as root" >&2
  exit 1
fi

# The new helper runs its self-test beside the one in place, and replaces it only if it passes:
# a helper that doesn't run breaks every change, System Update's included. (A name with a dot
# in front is one nothing else runs; mv replaces the file in one step.) It's one file:
# libexec/amahi-helper with its parts in place (bin/amahi-join-helper), so run as root it loads
# nothing but Ruby's standard library.
helper_new=/usr/local/sbin/.amahi-helper.new
rm -f "$helper_new"
if ! "$APP_DIR/bin/amahi-join-helper" > "$helper_new"; then
  rm -f "$helper_new"
  echo "Couldn't put the new privileged helper together; kept the one in place" >&2
  exit 1
fi
chown root:root "$helper_new"
chmod 0755 "$helper_new"
if ! "$helper_new" --self-test; then
  rm -f "$helper_new"
  echo "The new privileged helper failed its self-test; kept the one in place" >&2
  exit 1
fi
mv -f "$helper_new" /usr/local/sbin/amahi-helper

install -d -o root -g "$APP_GROUP" -m 0750 /var/log/amahi-kai
[[ -e /var/log/amahi-kai/helper.log ]] || install -o root -g "$APP_GROUP" -m 0640 /dev/null /var/log/amahi-kai/helper.log
if [[ -d /etc/logrotate.d ]]; then
  install -o root -g root -m 0644 "$APP_DIR/config/logrotate-amahi-kai.conf" /etc/logrotate.d/amahi-kai
fi
# The release keys: the update check checks the tag of the release it offers against them.
install -o root -g root -m 0644 "$APP_DIR/config/allowed_signers" /etc/amahi-kai/allowed_signers
# The dev branch isn't signature-checked, so the root helper switches a server to it only when
# this file allows that. A server that follows it already (a development install included: the
# installer writes the channel before it runs this) keeps being allowed to.
channel=$(sed -n 's/^AMAHI_UPDATE_CHANNEL=//p' /etc/amahi-kai/amahi.env 2>/dev/null | head -1 | tr -d "\"' " | tr '[:upper:]' '[:lower:]' || true)
if [[ "$channel" == development && ! -e /etc/amahi-kai/allow-development ]]; then
  install -o root -g root -m 0644 /dev/null /etc/amahi-kai/allow-development
  echo "Allowed the development channel (/etc/amahi-kai/allow-development): this server follows it"
fi
for unit in amahi-kai.service amahi-kai-indexer.service amahi-kai-indexer.timer \
            amahi-kai-update.service amahi-kai-update-check.service amahi-kai-update-check.timer \
            amahi-kai-storage-check.service amahi-kai-storage-check.timer \
            amahi-kai-snapshots.service amahi-kai-snapshots.timer amahi-kai-app-firewall.service \
            amahi-kai-app-firewall-early.service amahi-kai-app-shares.service \
            amahi-kai-app-backups.service amahi-kai-app-backups.timer \
            amahi-kai-trash.service amahi-kai-trash.timer \
            amahi-kai-tailscale.service amahi-kai-tailscale.path; do
  install -o root -g root -m 0644 "$APP_DIR/config/systemd/$unit" "/etc/systemd/system/$unit"
done
# The app catalog had a timer of its own; the update check fetches it now.
if [[ -e /etc/systemd/system/amahi-kai-catalog.timer ]]; then
  [[ -d /run/systemd/system ]] && systemctl disable --now amahi-kai-catalog.timer >/dev/null 2>&1
  rm -f /etc/systemd/system/amahi-kai-catalog.timer /etc/systemd/system/amahi-kai-catalog.service
fi
if [[ -d /run/systemd/system ]]; then
  systemctl daemon-reload
  # Enabled for the next boot only: at an install the database isn't ready yet, and an update
  # restarts the app itself once its code is in place.
  systemctl enable amahi-kai.service >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai.service; Amahi-kai won't start at boot" >&2
  systemctl enable amahi-kai-indexer.timer >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-indexer.timer; file search won't see new files on its own" >&2
  systemctl enable --now amahi-kai-update-check.timer >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-update-check.timer; the web UI's Check now still works" >&2
  systemctl enable --now amahi-kai-storage-check.timer >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-storage-check.timer; Disks → ZFS Pools' Check now still works" >&2
  systemctl enable --now amahi-kai-snapshots.timer >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-snapshots.timer; pools won't take snapshots on their own" >&2
  systemctl enable --now amahi-kai-app-backups.timer >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-app-backups.timer; app update copies won't be deleted after 30 days" >&2
  systemctl enable --now amahi-kai-trash.timer >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-trash.timer; the Trash won't delete old files on its own" >&2
  systemctl enable --now amahi-kai-tailscale.path >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-tailscale.path; after Tailscale signs in, save Network → DNS once" >&2
  # It ran once after each boot too, in 0.10.x on dev, when smbd needed a restart for Tailscale
  systemctl disable amahi-kai-tailscale.service >/dev/null 2>&1 || true
  # Starts with Docker from now on, and now if Docker is running (an update applies the rules).
  systemctl enable amahi-kai-app-firewall.service >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-app-firewall.service; app ports aren't limited to the LAN" >&2
  # And the same rules before Docker starts, so the apps' ports aren't open until they're in.
  systemctl enable amahi-kai-app-firewall-early.service >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-app-firewall-early.service; app ports are open at boot until Docker is up" >&2
  # And the share folders apps are given, mounted again before Docker starts them after a restart.
  systemctl enable amahi-kai-app-shares.service >/dev/null 2>&1 \
    || echo "Couldn't enable amahi-kai-app-shares.service; apps given folders of shares won't start after a restart" >&2
  if systemctl is-active --quiet docker.service; then
    systemctl restart amahi-kai-app-firewall.service \
      || echo "Couldn't limit app ports to the LAN and Tailscale (journalctl -u amahi-kai-app-firewall)" >&2
  fi
fi

# The docker group is root on the NAS. Apps run only through the helper now (Phase 4), so
# the app's user leaves the group older versions put it in.
if getent group docker >/dev/null && id -nG "$APP_USER" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
  gpasswd -d "$APP_USER" docker >/dev/null
  echo "Took $APP_USER out of the docker group"
fi

# A broken file in /etc/sudoers.d stops sudo working for everyone, so the new rules are
# checked first and the current file is kept if visudo refuses them. sudo skips files
# whose names contain a dot, so it never reads the temporary copy, and mv replaces the
# file in one step.
tmp=$(mktemp "$SUDOERS.XXXXXX")
trap 'rm -f "$tmp"' EXIT
install -o root -g root -m 0440 "$APP_DIR/config/sudoers/amahi-kai" "$tmp"
if visudo -cf "$tmp" >/dev/null; then
  mv -f "$tmp" "$SUDOERS"
else
  echo "The new sudoers rules failed visudo -c; kept the current $SUDOERS" >&2
  exit 1
fi
echo "Installed the privileged helper and sudoers rules"
