#!/usr/bin/ruby --disable-gems
# frozen_string_literal: true

# amahi-helper: the program Amahi-kai runs as root for user accounts, Samba, share
# folders, system services, the hostname, dnsmasq's and Unbound's configs, swap, reboot/power off, data
# drives, ZFS pools, Greyhole, package installs, the Cloudflare Tunnel, Tailscale, the
# security audit's fixes and the Docker apps. It is the app's only sudo rule.
#
#   sudo -n /usr/local/sbin/amahi-helper users.create    (stdin: {"login":"ann","name":"Ann"})
#   stdout: {"ok":true}  or  {"ok":false,"error":"..."}
#
# The operation name is the only argument. Everything else, passwords included, comes
# as one JSON object on stdin, so it never shows in ps, the journal or sudo's log.
# Exit status: 0 done, 1 refused (the request was invalid; nothing changed), 2 a step
# failed.
#
# The app is not trusted: every request is checked here. Commands run by absolute path
# as argument lists (no shell) with a minimal environment, and every call is logged as
# one JSON line in /var/log/amahi-kai/helper.log with secrets filtered out.
#
# Installed as /usr/local/sbin/amahi-helper (root:root 0755) by bin/amahi-install and
# bin/amahi-update. Standard library only, and no gems (--disable-gems): gems and the
# app live in directories the app user can write, and must never load in a root process.
#
#   amahi-helper --self-test            check the operation table and exit
#   amahi-helper --list                 print the operation names
#   amahi-helper --dry-run OP           validate stdin and print the planned steps; changes nothing
#   amahi-helper --check-catalog DIR    check every app manifest in DIR (the catalog repo's CI)

require 'json'
require 'etc'
require 'find'
require 'tmpdir'
require 'open3'
require 'securerandom'
require 'digest'
require 'time'
require 'yaml'
require 'fileutils'
require 'ipaddr'
require 'socket'

module AmahiHelper
  ENV_MIN = { 'PATH' => '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG' => 'C.UTF-8' }.freeze
  LOG_DIR = '/var/log/amahi-kai'
  LOG_FILE = "#{LOG_DIR}/helper.log".freeze
  MAX_INPUT = 2 * 1024 * 1024

  APP_USER = 'amahi'
  USERS_GROUP = 'users' # primary group of the accounts the app creates
  NOLOGIN = '/usr/sbin/nologin'
  UID_MIN = 1000

  SHARE_ROOT = '/var/lib/amahi-kai/files'
  DRIVES_ROOT = '/mnt' # data drives are mounted at /mnt/<name>

  SMB_CONF = '/etc/samba/smb.conf'
  LMHOSTS = '/etc/samba/lmhosts'
  HOSTS = '/etc/hosts'
  TESTPARM = '/usr/bin/testparm'

  DNSMASQ_CONF = '/etc/dnsmasq.d/amahi.conf'
  DNSMASQ = '/usr/sbin/dnsmasq'
  DNSMASQ_LEASES = '/var/lib/misc/dnsmasq.leases'
  UNBOUND = '/usr/sbin/unbound'
  UNBOUND_CHECKCONF = '/usr/sbin/unbound-checkconf'
  UNBOUND_CONTROL = '/usr/sbin/unbound-control'
  # Ubuntu's unbound.conf includes every unbound.conf.d/*.conf: Amahi-kai's, and the names of
  # the devices dnsmasq gave addresses to (do_sync_leases).
  UNBOUND_CONF = '/etc/unbound/unbound.conf.d/amahi-kai.conf'
  UNBOUND_LEASES = '/etc/unbound/unbound.conf.d/amahi-kai-leases.conf'
  # Names a device can't take in the NAS's DNS by asking DHCP for them: browsers look for their
  # proxy settings at wpad and Windows for an IPv6 tunnel at isatap (the two Windows' own DNS
  # server blocks), and localhost is every machine's own.
  RESERVED_LEASE_NAMES = %w[localhost wpad isatap].freeze
  CA_CERTS = '/etc/ssl/certs/ca-certificates.crt'
  # While dnsmasq hands out addresses, systemd runs dns.sync_leases each time its lease file
  # changes, so the devices' names answer in DNS. PathModified, not PathChanged: dnsmasq keeps
  # the file open and rewrites it in place, so it's never closed after a write.
  DHCP_NAMES_PATH = '/etc/systemd/system/amahi-kai-dhcp-names.path'
  DHCP_NAMES_PATH_CONTENT = <<~UNIT
    [Unit]
    Description=Amahi-kai: DNS names for the devices DHCP gives addresses to

    [Path]
    PathModified=#{DNSMASQ_LEASES}

    [Install]
    WantedBy=multi-user.target
  UNIT
  DHCP_NAMES_SERVICE = '/etc/systemd/system/amahi-kai-dhcp-names.service'
  DHCP_NAMES_SERVICE_CONTENT = <<~UNIT
    [Unit]
    Description=Amahi-kai: DNS names for the devices DHCP gives addresses to
    # Devices joining at once rewrite the leases several times a second: with systemd's default
    # limit (5 starts in 10 s), a burst stopped this job for good, and the watch with it.
    StartLimitIntervalSec=0

    [Service]
    Type=oneshot
    ExecStart=/usr/local/sbin/amahi-helper dns.sync_leases
    StandardInputText={}
  UNIT
  # How long to listen for another DHCP server's offer. dnsmasq (which many routers run, OpenWrt
  # among them) pings an address for 3 seconds to see it's free before it offers it.
  DHCP_WAIT = 6

  # DNS blocklists (Network → DNS, DHCP and Internet). BLOCKLISTS are the lists the NAS may download, by
  # key; the app names and describes the same keys (DnsService::BLOCKLISTS, a spec checks they
  # match). Each is a domain a line, "#" comments, and a domain covers its subdomains (HaGeZi's
  # and OISD's wildcard formats without "*."), as Unbound's local-zone does. Checked against
  # the projects' own pages 2026-10-22; both GPL-3.0, refreshed daily.
  HAGEZI = 'https://raw.githubusercontent.com/hagezi/dns-blocklists/main/wildcard'
  BLOCKLISTS = {
    'hagezi-light' => { url: "#{HAGEZI}/light-onlydomains.txt" },
    'hagezi-normal' => { url: "#{HAGEZI}/multi-onlydomains.txt" },
    'hagezi-pro' => { url: "#{HAGEZI}/pro-onlydomains.txt" },
    'hagezi-tif-mini' => { url: "#{HAGEZI}/tif.mini-onlydomains.txt" },
    'hagezi-tif-medium' => { url: "#{HAGEZI}/tif.medium-onlydomains.txt" },
    'oisd-small' => { url: 'https://small.oisd.nl/domainswild2' },
    'oisd-big' => { url: 'https://big.oisd.nl/domainswild2' },
    # The known encrypted-DNS (DoH) providers, so a device can't go around the NAS's DNS by name.
    'hagezi-doh' => { url: "#{HAGEZI}/doh-onlydomains.txt" },
    # Vendors' own telemetry hosts, with the hosts their devices need left out.
    'hagezi-native-samsung' => { url: "#{HAGEZI}/native.samsung-onlydomains.txt" },
    'hagezi-native-lgwebos' => { url: "#{HAGEZI}/native.lgwebos-onlydomains.txt" },
    'hagezi-native-roku' => { url: "#{HAGEZI}/native.roku-onlydomains.txt" },
    'hagezi-native-amazon' => { url: "#{HAGEZI}/native.amazon-onlydomains.txt" },
    'hagezi-native-apple' => { url: "#{HAGEZI}/native.apple-onlydomains.txt" },
    'hagezi-native-winoffice' => { url: "#{HAGEZI}/native.winoffice-onlydomains.txt" },
    'hagezi-native-tiktok' => { url: "#{HAGEZI}/native.tiktok-onlydomains.txt" },
    'hagezi-native-xiaomi' => { url: "#{HAGEZI}/native.xiaomi-onlydomains.txt" }
  }.freeze
  # Root's own folder: the lists chosen and the allowlist, the copies downloaded, the blocklist
  # while blocking is paused, and the status the app reads. Not the app's: what's here becomes
  # Unbound's config.
  BLOCKLIST_DIR = '/var/lib/amahi-kai-dns'
  BLOCKLIST_CHOSEN = "#{BLOCKLIST_DIR}/chosen.json".freeze
  BLOCKLIST_STATUS = "#{BLOCKLIST_DIR}/status.json".freeze
  BLOCKLIST_PAUSED = "#{BLOCKLIST_DIR}/blocklist.paused".freeze
  # When the helper last reloaded Unbound: its counters start again then (Network → DNS, DHCP and Internet's
  # totals say since when).
  UNBOUND_RELOADED = "#{BLOCKLIST_DIR}/reloaded_at".freeze
  UNBOUND_BLOCKLIST = '/etc/unbound/unbound.conf.d/amahi-kai-blocklist.conf'
  UNBOUND_MAIN = '/etc/unbound/unbound.conf'
  BLOCKLIST_MAX_BYTES = 64 * 1024 * 1024
  # About 150 MB of Unbound's memory per 300,000 (measured on Unbound 1.19).
  BLOCKLIST_MAX_DOMAINS = 1_000_000
  # A copy downloaded less than this long ago isn't downloaded again.
  BLOCKLIST_FRESH = 20 * 3600
  ALLOWLIST_MAX = 1000
  # A name a list may block: labels, then a top-level domain that isn't a number.
  BLOCK_DOMAIN = /\A(?=.{4,253}\z)(?:[a-z0-9_](?:[a-z0-9_-]{0,61}[a-z0-9_])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]\z/
  BLOCKLIST_SERVICE = '/etc/systemd/system/amahi-kai-blocklists.service'
  BLOCKLIST_SERVICE_CONTENT = <<~UNIT
    [Unit]
    Description=Amahi-kai: refresh the DNS blocklists
    Wants=network-online.target
    After=network-online.target unbound.service

    [Service]
    Type=oneshot
    ExecStart=/usr/local/sbin/amahi-helper dns.refresh_blocklists
  UNIT
  BLOCKLIST_TIMER = '/etc/systemd/system/amahi-kai-blocklists.timer'
  BLOCKLIST_TIMER_CONTENT = <<~UNIT
    [Unit]
    Description=Amahi-kai: refresh the DNS blocklists every day

    [Timer]
    OnCalendar=*-*-* 04:00
    RandomizedDelaySec=2h
    Persistent=true

    [Install]
    WantedBy=timers.target
  UNIT
  # Pausing blocking: a transient systemd timer resumes it.
  DNS_RESUME_UNIT = 'amahi-kai-dns-resume'
  BLOCKING_PAUSE = 300

  # IPv6 (Network → DNS, DHCP and Internet): radvd announces the NAS as the network's IPv6 DNS server, at an
  # address of its own in a unique local range (ULA_UNIT puts it on the interface at boot).
  RADVD = '/usr/sbin/radvd'
  RADVD_CONF = '/etc/radvd.conf'
  ULA_UNIT = '/etc/systemd/system/amahi-kai-ula.service'
  ULA = IPAddr.new('fc00::/7')
  # How long to listen for routers' announcements (a router waits up to 3 seconds between them).
  RA_WAIT = 4

  # Router mode (Network → DNS, DHCP and Internet): the NAS between the LAN and the internet. The internet
  # interface gets its address by DHCP (WAN_NETPLAN), the kernel forwards, UFW's before.rules
  # get a NAT block (ROUTER_BEGIN..ROUTER_END: masquerade out, and the port forwards in), and
  # UFW's rules let the LAN out, the forwards in, and nothing else in on the internet side.
  # ROUTER_STATE holds what's in place, for the way back and for lan_subnets.
  NETPLAN = '/usr/sbin/netplan'
  NETPLAN_DIR = '/etc/netplan'
  WAN_NETPLAN = "#{NETPLAN_DIR}/70-amahi-kai-wan.yaml".freeze
  # The netplan files as the helper last applied them (a digest): a save that changes none of
  # them doesn't apply them again. An apply has networkd set up every interface it manages
  # again, so the internet side asks its provider for its lease again and addresses networkd
  # didn't make (the NAS's own IPv6 one for DNS, ULA_UNIT) go.
  NETPLAN_APPLIED = "#{BLOCKLIST_DIR}/netplan-applied".freeze
  # The LAN interface's own default route (to the router the NAS replaces) goes behind the
  # internet interface's (50). Its netplan file is kept as it was, for the way back.
  LAN_ROUTE_METRIC = 200
  NETPLAN_BACKUP_SUFFIX = '.amahi-kai-before-router'
  ROUTER_SYSCTL = '/etc/sysctl.d/90-amahi-kai-router.conf'
  ROUTER_STATE = "#{BLOCKLIST_DIR}/router.json".freeze
  UFW_CONF = '/etc/ufw/ufw.conf'
  UFW_BEFORE_RULES = '/etc/ufw/before.rules'
  UFW_BEFORE6_RULES = '/etc/ufw/before6.rules'
  ROUTER_BEGIN = '# BEGIN amahi-kai router'
  ROUTER_END = '# END amahi-kai router'
  # The NAT block's rules live in chains of the NAS's own, which the block flushes before
  # refilling: UFW's reload re-reads before.rules without clearing the nat table, so rules put
  # straight in PREROUTING and POSTROUTING pile up, a copy per reload (found 2026-10-24: an old
  # copy kept redirecting DNS to the NAS's previous address).
  NAT_PREROUTING = 'amahi-kai-prerouting'
  NAT_POSTROUTING = 'amahi-kai-postrouting'
  # The block's filter part, in front of UFW's own before rules: those accept ICMP (pings among
  # them) ahead of any rule added through ufw, so a kept-off device could still ping out and
  # the NAS answered pings from the internet.
  ROUTER_FILTER_BEGIN = '# BEGIN amahi-kai router filter'
  ROUTER_FILTER_END = '# END amahi-kai router filter'
  # Service discovery (mDNS, SSDP), which UFW's before rules accept in from anywhere, for IPv4
  # and IPv6 (before6.rules gets a filter part of its own): dropped in on the internet side,
  # where Avahi would answer whoever shares the provider's network.
  DISCOVERY_PORTS = %w[5353 1900].freeze
  # The shape of the router's rules, kept in ROUTER_STATE: bumped whenever it changes, so the
  # app's resync after an update (DnsService.resync!) puts the new shape in place.
  ROUTER_RULES_VERSION = 4
  # The router's kernel settings besides forwarding, for all interfaces and for the internet
  # side: strict reverse-path filtering there (Ubuntu sets every interface loose, 2, and the
  # kernel takes the stricter of all and the interface's own, so all goes to 1 and only the
  # internet interface's own 1 bites); ICMP redirects neither taken nor sent there (a redirect
  # would move the NAS's routes; accepting is AND of all and the interface's while forwarding,
  # sending is OR, so both go to 0 on all as well); and martians, packets with an impossible
  # source, logged on the internet side.
  ROUTER_SYSCTL_ALL = { 'rp_filter' => '1', 'accept_redirects' => '0', 'send_redirects' => '0' }.freeze
  ROUTER_SYSCTL_WAN = { 'rp_filter' => '1', 'accept_redirects' => '0', 'send_redirects' => '0', 'log_martians' => '1' }.freeze
  PORT_FORWARD_MAX = 50
  # Devices kept off the internet (Network → Devices, LAN only), by address.
  LAN_ONLY_MAX = 200
  # Tailscale's own port: let in on the internet side so its connections stay direct.
  TAILSCALE_PORT = '41641'

  # The NAS's own address on an interface (Network → Devices, This NAS): the IPv4 part of the
  # interface's netplan entry is rewritten, automatic (DHCP) or a fixed address with its router
  # and DNS servers, each file changed kept as it was beside it (ADDRESS_BACKUP_SUFFIX). A change
  # to the interface the admin is connected through (guard) is applied ADDRESS_APPLY_WAIT seconds
  # after the reply, so the reply gets out, and kept only once something reaches the NAS at the
  # new address within ADDRESS_KEEP_WAIT seconds (network.keep_address); otherwise the revert
  # timer puts the files back. ADDRESS_STATE says where that stands.
  ADDRESS_STATE = "#{BLOCKLIST_DIR}/address.json".freeze
  ADDRESS_BACKUP_SUFFIX = '.amahi-kai-before-address'
  ADDRESS_APPLY_UNIT = 'amahi-kai-address-apply'
  ADDRESS_REVERT_UNIT = 'amahi-kai-address-revert'
  ADDRESS_APPLY_WAIT = 2
  ADDRESS_KEEP_WAIT = 90
  # A change left waiting this long (the NAS rebooted meanwhile, and its timers with it) is
  # taken as kept: whoever asks for the next one reached the NAS as it is.
  ADDRESS_STALE = 600
  # The DNS and network operations that change what's in place run one at a time, the next
  # waiting its turn for up to NETWORK_LOCK_WAIT seconds: a keep and a revert of the NAS's
  # address, or two saves rewriting the router's rules, would otherwise interleave their steps.
  NETWORK_LOCK = '/run/amahi-kai-network.lock'
  NETWORK_LOCK_WAIT = 120
  NETWORK_LOCKED = %w[
    dns.write_config dns.remove_config dns.sync_leases dns.names_setup dns.set_blocklists dns.blocking_off dns.write_radvd_config
    dns.remove_radvd_config dns.set_own_address dns.remove_own_address network.write_dnsmasq_config network.router_on
    network.router_off network.set_address network.apply_address network.keep_address network.revert_address
  ].freeze
  # Addresses an interface can't have.
  UNUSABLE_NETS = %w[0.0.0.0/8 127.0.0.0/8 224.0.0.0/3].map { |net| IPAddr.new(net) }.freeze

  # The services Settings → Servers may control: the entries in lib/system_services.rb
  # that list actions (spec/lib/amahi_helper_spec.rb checks the two lists match).
  SERVICES = {
    'smbd' => 'smbd.service', 'nmbd' => 'nmbd.service', 'dnsmasq' => 'dnsmasq.service', 'unbound' => 'unbound.service',
    'radvd' => 'radvd.service',
    'greyhole' => 'greyhole.service', 'docker' => 'docker.service', 'avahi-daemon' => 'avahi-daemon.service'
  }.freeze

  UPDATE_UNIT = '/etc/systemd/system/amahi-kai-update.service'
  # Checking for updates: bin/amahi-update holds UPDATE_LOCK while it runs, and the check
  # takes it too, so a fetch never races the update's pull. The check writes what it found
  # to UPDATE_STATUS (the app reads it). REPAIR_FLAG tells the next update to run every
  # step even with nothing new (bin/amahi-update reads and removes it).
  APP_DIR = '/opt/amahi-kai'
  GIT = '/usr/bin/git'
  GIT_OPTIONS = ['-c', 'core.hooksPath=/dev/null', '-c', 'core.fsmonitor=false', '-C', APP_DIR].freeze
  UPDATE_LOCK = '/run/amahi-kai-update.lock'
  UPDATE_STATUS = '/var/lib/amahi-kai/update-status.json'
  UPDATE_REPAIR_FLAG = '/run/amahi-kai-update.repair'
  UPDATE_LIST_LIMIT = 50
  # Where System Update gets new versions: AMAHI_UPDATE_CHANNEL in ENV_FILE (root's), one of
  # UPDATE_CHANNELS. releases, the default, installs the newest release published on GitHub;
  # candidates also its pre-releases (release candidates); development the dev branch's newest
  # commit, for testing. A release is a tag vX.Y.Z (a candidate vX.Y.ZrcN) whose commit's VERSION
  # file names that version. Nothing newer than what runs is never a reason to go back.
  ENV_FILE = '/etc/amahi-kai/amahi.env'
  UPDATE_CHANNELS = %w[releases candidates development].freeze
  RELEASES_URL = 'https://api.github.com/repos/CatDogBark/Amahi-kai/releases?per_page=30'
  RELEASE_TAG = /\Av(\d{1,4})\.(\d{1,4})\.(\d{1,4})(?:rc(\d{1,4}))?\z/
  RELEASE_VERSION = /\A\d{1,4}\.\d{1,4}\.\d{1,4}(?:rc\d{1,4})?\z/

  SWAPFILE = '/swapfile'
  FSTAB = '/etc/fstab'

  # Data drives: whole disks or partitions on SATA/SAS/virtio/Xen and NVMe devices,
  # mounted at /mnt/<name>. The fstab options are the ones PR #13 settled on: nofail and
  # a short timeout, so a missing drive can't stop the NAS booting.
  MNT = '/mnt'
  # Makes a data drive's empty mount point immutable while nothing is mounted on it (see
  # protect_mount_point).
  CHATTR = '/usr/bin/chattr'
  # How long a deleted user's sessions get to end before they're made to.
  USER_STOP_SECONDS = 5
  # The folder Greyhole keeps its metadata backups in, on each pool drive.
  GREYHOLE_METASTORE_BACKUP = '.gh_metastore_backup'
  DISK_DEVICE = %r{\A/dev/(?:[svx]d[a-z]{1,2}\d{0,3}|nvme\d{1,3}n\d{1,3}(?:p\d{1,3})?)\z}
  MOUNT_NAME = /\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\z/
  WHOLE_DISK = %r{\A/dev/(?:[svx]d[a-z]{1,2}|nvme\d{1,3}n\d{1,3})\z}
  SMARTCTL = '/usr/sbin/smartctl'
  # Where `smartctl -A` reports the temperature, in °C. ATA drives: the raw value of attribute
  # 194 (Temperature_Celsius) or 190 (Airflow_Temperature_Cel), the tenth column. NVMe and
  # SAS drives print a line of their own.
  TEMPERATURE_PATTERNS = [
    /^\s*194\s+\S+(?:\s+\S+){7}\s+(\d+)/,
    /^\s*190\s+\S+(?:\s+\S+){7}\s+(\d+)/,
    /^Temperature:\s+(\d+) Celsius/,
    /^Current Drive Temperature:\s+(\d+)/
  ].freeze
  MOUNTABLE_FS = %w[ext2 ext3 ext4 xfs btrfs ntfs vfat exfat].freeze
  # FAT and exFAT keep no owners or permissions: everything on a drive like that belongs to the
  # mount, root's by default, so only root could write there. They're mounted for the users group
  # (the share folders' group), which may write: folders 0775, files 0664. (ntfs-3g lets everyone
  # write unless told otherwise.)
  OWNERLESS_FS = %w[vfat exfat].freeze
  OWNERLESS_MASKS = %w[dmask=0002 fmask=0113].freeze
  # Data drives mount nosuid,nodev: nothing on a drive (one brought from elsewhere, or written
  # by an app) can run with privileges or stand in for a device. The share root, on the OS
  # disk, gets the same by a bind mount of itself (SHARE_ROOT_FSTAB). disks.secure_mounts
  # brings fstab lines written before (FSTAB_OPTIONS_BEFORE) and the live mounts up to this.
  MOUNT_OPTIONS = %w[nosuid nodev].freeze
  FSTAB_OPTIONS = "defaults,nofail,#{MOUNT_OPTIONS.join(',')},x-systemd.device-timeout=10s".freeze
  FSTAB_OPTIONS_BEFORE = 'defaults,nofail,x-systemd.device-timeout=10s'
  SHARE_ROOT_FSTAB = "#{SHARE_ROOT} #{SHARE_ROOT} none bind,#{MOUNT_OPTIONS.join(',')} 0 0".freeze
  FINDMNT = '/usr/bin/findmnt'
  PREVIEW_LIMIT = { entries: 1_000_000, seconds: 30 }.freeze
  # Where the helper makes its temporary folders (preview mounts, downloaded keys):
  # writable only by root.
  RUN_DIR = '/run'

  # ZFS pools (docs/plans/storage.md), on whole disks of their own, mounted under POOL_ROOT, not
  # /mnt. A share on a pool lives in its shares dataset, POOL_ROOT/<pool>/shares (pools.shares_root):
  # share folders are made there, in SHARE_ROOT, or on data drives under /mnt, and nowhere else
  # on a pool. bitShare's data gets a dataset of its own (Phase 4).
  ZPOOL = '/usr/sbin/zpool'
  ZFS = '/usr/sbin/zfs'
  WIPEFS = '/usr/sbin/wipefs'
  POOL_ROOT = '/srv/pools'
  POOL_NAME = /\A[a-z][a-z0-9_-]{0,31}\z/
  # Words zpool keeps for vdev types, and names that look like Solaris disks (c0...).
  RESERVED_POOL_NAMES = /\A(?:mirror|raidz\d?|draid\d?|spare|log|cache|special|dedup|c\d.*)\z/
  # The layouts a new pool may have: the fewest drives, and whether they go in pairs.
  POOL_LAYOUTS = {
    'mirror' => { min: 2 }, 'striped_mirrors' => { min: 4, pairs: true },
    'raidz1' => { min: 3 }, 'raidz2' => { min: 4 }, 'raidz3' => { min: 5 }
  }.freeze
  POOL_MAX_DRIVES = 24
  # A pool names its drives by these /dev/disk/by-id links (model and serial first, so a
  # failed drive can be found), so it doesn't depend on the order drives appear at boot.
  BY_ID = '/dev/disk/by-id'
  BY_ID_PREFERENCE = %w[ata- nvme- scsi- wwn- virtio-].freeze
  # ZFS's memory cache (ARC): at most 2 GiB, and at most half the memory. ZFS keeps at least a
  # 32nd of the memory cached and ignores a cap that isn't above that (at boot without a word,
  # and a running module refuses it), so on a server with more than 64 GiB the cap is just above
  # it: ARC_MARGIN more.
  ARC_LIMIT = 2 * 1024**3
  ARC_MARGIN = 64 * 1024**2
  MEMINFO = '/proc/meminfo'
  ZFS_MODPROBE = '/etc/modprobe.d/zfs-amahi.conf'
  ZFS_ARC_MAX = '/sys/module/zfs/parameters/zfs_arc_max'
  # The cache's own figures; c_max is the cap ZFS uses.
  ARCSTATS = '/proc/spl/kstat/zfs/arcstats'
  # Ubuntu's smartmontools unit has ConditionVirtualization=no, so smartd never starts in a
  # virtual machine, even one given real drives (a drive controller passed through to it; the
  # unit's own comment says to override it then). An empty assignment resets the unit's
  # conditions, and that's its only one. With only virtual disks, smartd finds nothing with SMART
  # and stops itself, which System Status shows as idle.
  SMARTD_DROPIN = '/etc/systemd/system/smartmontools.service.d/amahi-kai.conf'
  SMARTD_DROPIN_CONTENT = <<~UNIT
    # Amahi-kai: start in a virtual machine too, which can be given real drives.
    [Unit]
    ConditionVirtualization=
  UNIT
  # Snapshots: amahi-kai-snapshots.timer runs pools.run_snapshots every hour. Each pool keeps
  # its newest N hourly and daily snapshots, N in its own ZFS properties (amahi:snapshot-hourly,
  # amahi:snapshot-daily; unset means the default). Only snapshots named like ours are ever
  # destroyed; manual ones are never pruned.
  SNAPSHOT_KINDS = { 'hourly' => 50 * 60, 'daily' => 23 * 3600 }.freeze # kind => seconds before the next is due
