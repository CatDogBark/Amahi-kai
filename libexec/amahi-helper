#!/usr/bin/ruby --disable-gems
# frozen_string_literal: true

# amahi-helper: the program Amahi-kai runs as root for user accounts, Samba, share
# folders, system services, the hostname, dnsmasq's and Unbound's configs, swap, reboot/power off, data
# drives, ZFS pools, Greyhole, package installs, the Cloudflare Tunnel, Tailscale, the
# security audit's fixes and the Docker apps. It is the app's only sudo rule.
#
#   sudo -n /usr/local/sbin/amahi-helper users.create    (stdin: {"login":"ann","name":"Ann"})
#   stdout: {"ok":true}  or  {"ok":false,"error":"..."}
#
# The operation name is the only argument. Everything else, passwords included, comes
# as one JSON object on stdin, so it never shows in ps, the journal or sudo's log.
# Exit status: 0 done, 1 refused (the request was invalid; nothing changed), 2 a step
# failed.
#
# The app is not trusted: every request is checked here. Commands run by absolute path
# as argument lists (no shell) with a minimal environment, and every call is logged as
# one JSON line in /var/log/amahi-kai/helper.log with secrets filtered out.
#
# Its source is this file and its parts, one per area, in libexec/amahi-helper.d/: an operation
# goes in its area's part (add_operations), with its code. bin/amahi-join-helper puts them
# together as one file, which bin/amahi-install-helper (run by bin/amahi-install and
# bin/amahi-update) installs as /usr/local/sbin/amahi-helper (root:root 0755) once it passes its
# self-test. Standard library only, and no gems (--disable-gems): gems and the app live in
# directories the app user can write, and must never load in a root process.
#
#   amahi-helper --self-test            check the operation table and exit
#   amahi-helper --list                 print the operation names
#   amahi-helper --dry-run OP           validate stdin and print the planned steps; changes nothing
#   amahi-helper --check-catalog DIR    check every app manifest in DIR (the catalog repo's CI)

require 'json'
require 'etc'
require 'find'
require 'tmpdir'
require 'open3'
require 'securerandom'
require 'digest'
require 'time'
require 'yaml'
require 'fileutils'
require 'ipaddr'
require 'socket'

# The helper's parts, in this order: core (the operation table, the entry points and what every
# area uses), then one part per area, each with its operations and their code. For the one file
# installed as /usr/local/sbin/amahi-helper, bin/amahi-join-helper puts each part in place of the
# line that loads it here: run as root, the helper loads nothing but Ruby's standard library.
require_relative 'amahi-helper.d/core'
require_relative 'amahi-helper.d/sharing'
require_relative 'amahi-helper.d/disks'
require_relative 'amahi-helper.d/pools'
require_relative 'amahi-helper.d/greyhole'
require_relative 'amahi-helper.d/dns'
require_relative 'amahi-helper.d/network'
require_relative 'amahi-helper.d/apps'
require_relative 'amahi-helper.d/system'

AmahiHelper::OPERATIONS.freeze

if $PROGRAM_NAME == __FILE__
  File.umask(0o022)
  exit AmahiHelper.main(ARGV)
end
