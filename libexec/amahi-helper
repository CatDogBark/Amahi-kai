  # {{uid}}, {{gid}} and {{timezone}} in a manifest's environment are filled in at install.
  APP_PLACEHOLDERS = /\{\{(uid|gid|timezone)\}\}/
  # The host ports each app was given (P4.2): its catalog ports when they're free, others when
